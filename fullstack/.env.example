# EGM4000 production environment example — NEVER commit real secret values.

# Production mode activates the fail-closed readiness gate and HSTS.
EGM_ENV=production

# Canonical public HTTPS origin used by Android/Web deployment checks.
EGM_PUBLIC_BASE_URL=https://egm4000.example.com

# PostgreSQL / Supabase connection string. Use the provider-issued URI and its
# required SSL settings. EGM4000 accepts postgres:// or postgresql:// URLs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Sole owner account. Password is mandatory on first bootstrap and must be 20+
# characters in production. Do not reuse it as any other application secret.
EGM_OWNER_USERNAME=EGM4000Owner
EGM_OWNER_PASSWORD=replace-with-a-long-random-owner-secret

# Independent 32+ character HMAC secret for privacy-preserving visitor identifiers.
EGM_VISITOR_SECRET=replace-with-a-different-long-random-secret

# Deployment-held owner recovery token and Base32 TOTP secret. Neither is stored
# in the application database.
EGM_OWNER_RECOVERY_TOKEN=replace-with-a-32-plus-character-random-token
EGM_OWNER_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Required on a public HTTPS deployment.
EGM_SECURE_COOKIES=1

# Railway/reverse-proxy deployments should set this to 1 only when the immediate
# upstream proxy is trusted to supply X-Forwarded-For. Otherwise leave 0.
EGM_TRUST_PROXY=1

# Choose one backup policy. Set a durable mounted directory, OR declare that the
# managed PostgreSQL provider supplies durable backups.
# EGM_BACKUP_DIR=/durable/egm4000-backups
EGM_MANAGED_DATABASE_BACKUPS=1

# Optional provider integrations. If enabled, these secrets must be 32+ chars.
# EGM_BILLING_WEBHOOK_SECRET=replace-with-long-provider-signing-secret
# EGM_FSA_TELEMETRY_TOKEN=replace-with-long-owned-fsa-bridge-secret

# The host supplies PORT in production. 8040 is the local default.
PORT=8040
