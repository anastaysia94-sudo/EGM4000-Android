# EGM4000 production environment example — NEVER commit real secret values.

# PostgreSQL / Supabase connection string. Use the provider-issued URI and include its
# required SSL settings. EGM4000 accepts postgres:// or postgresql:// URLs.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Sole owner account. Username is optional; password is mandatory on first bootstrap.
EGM_OWNER_USERNAME=EGM4000Owner
EGM_OWNER_PASSWORD=replace-with-a-long-random-secret

# Used for privacy-preserving visitor/network HMAC identifiers.
EGM_VISITOR_SECRET=replace-with-a-long-random-secret

# Required on a public HTTPS deployment.
EGM_SECURE_COOKIES=1

# The host supplies PORT in production. 8040 is the local default.
PORT=8040

# Optional only when the separate owned F.S.A. telemetry bridge is actively connected.
# EGM_FSA_TELEMETRY_TOKEN=replace-with-a-long-random-secret
