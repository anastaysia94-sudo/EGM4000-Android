function authScreen(){A.innerHTML=`<div class="login-wrap"><div class="hero"><div class="tag">Secure EGM4000 account</div><h1>Enter the control room.</h1><p class="muted">Your Fire Kirin, GameVault, Panda Master, Juwa, or other provider credentials never belong here.</p></div><div class="grid"><div class="card span6"><h2>Sign in</h2><form id="loginF"><input name="username" placeholder="Username" required><input name="password" type="password" placeholder="Password" required><button class="primary">Sign in</button></form><p id="loginE" class="warn"></p></div><div class="card span6"><h2>Create account</h2><form id="regF"><input name="display_name" placeholder="Display name" required><input name="username" placeholder="Username" required><input name="email" type="email" placeholder="Email" required><input name="password" type="password" minlength="10" placeholder="Password (10+ characters)" required><select name="favorite_platform"><option>Fire Kirin</option><option>GameVault</option><option>Panda Master</option><option>Juwa</option><option>Other</option></select><input name="skill_focus" placeholder="What do you want EGM to help analyze?"><button class="aqua">Create account</button></form><p id="regE" class="warn"></p></div></div><div class="actions"><button id="guest">Continue as visitor</button></div></div>`;loginF.onsubmit=async e=>{e.preventDefault();try{await post('/api/login',Object.fromEntries(new FormData(loginF)));boot()}catch(x){loginE.textContent=x.message}};regF.onsubmit=async e=>{e.preventDefault();try{await post('/api/register',Object.fromEntries(new FormData(regF)));regE.className='good';regE.textContent='Account created. Sign in on the left.'}catch(x){regE.textContent=x.message}};guest.onclick=()=>render()}
async function render(){try{if(S.view==='today')return today();if(S.view==='tips')return tips();if(S.view==='community')return community();if(S.view==='surveys')return surveys();if(S.view==='live')return live();if(S.view==='admin')return admin()}catch(e){shell(`<div class="card"><h2>Could not load this module</h2><p class="warn">${esc(e.message)}</p></div>`)}}
async function today(){let sum=S.me?await api('/api/summary'):{gameplay_sessions:0,tips:0,threads:0,posts:0};shell(`<div class="hero"><div class="tag">Command Center</div><h1>${S.me?'Welcome back, '+esc(S.me.display_name):'Evidence first. Hype last.'}</h1><p>EGM4000 turns user-authorized gameplay evidence into replayable metrics, cautious pattern analysis, and evidence-linked coaching.</p><div class="actions"><button class="aqua" data-go="live">Start a session</button><button data-go="tips">Review tips</button><button data-go="community">Community</button></div></div><div class="grid"><div class="card metric span4"><span class="tag">Sessions</span><b>${sum.gameplay_sessions}</b><span class="muted">recorded or seeded history</span></div><div class="card metric span4"><span class="tag">Tips</span><b>${sum.tips}</b><span class="muted">evidence-linked guidance</span></div><div class="card metric span4"><span class="tag">Community</span><b>${sum.threads+sum.posts}</b><span class="muted">your discussions + posts</span></div><div class="card span8"><h2>What EGM can say</h2><p><span class="pill">observed evidence</span><span class="pill">estimate</span><span class="pill">correlation</span><span class="pill">hypothesis</span></p><p class="muted">EGM can compare your logged sessions and surface statistically meaningful changes. It cannot know hidden server state or guarantee the next outcome.</p></div><div class="card span4"><h2>Install</h2><p class="muted">Use your browser's <b>Install app</b> / <b>Add to Home Screen</b> option to keep EGM4000 on Android, iPhone, iPad, Windows, or Mac.</p></div></div>`);document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>{S.view=b.dataset.go;render()})}
function fmtMetric(v){return v===null||v===undefined?'—':Number(v).toFixed(2)}
function expCard(x){let state=x.resultLabel||'Insufficient Evidence',pct=x.percent_change===null||x.percent_change===undefined?'':` · ${Number(x.percent_change).toFixed(1)}%`;return `<div class="feed-item"><div class="topline"><h3>${esc(x.tip_title||'Coaching comparison')}</h3><span class="pill">${esc(state)}</span></div><p><b>${esc(x.metricLabel||x.target_metric)}</b>: ${fmtMetric(x.baseline_value)} → ${fmtMetric(x.followup_value)}${pct}</p><p class="muted">Baseline session #${esc(x.baseline_live_session_id)} · follow-up ${x.followup_live_session_id?'#'+esc(x.followup_live_session_id):'not attached yet'} · samples ${esc(x.baseline_sample_size)}/${esc(x.followup_sample_size)} · confidence ${Math.round(Number(x.confidence||0)*100)}%</p><p class="muted">${esc(x.uncertainty||'Waiting for comparable evidence.')}</p></div>`}
async function tips(){if(!S.me)return authScreen();let [rows,experiments]=await Promise.all([api('/api/tips'),api('/api/experiments')]);shell(`<div class="hero"><div class="tag">Gameplay Tips Center · C014</div><h1>Recommend. Re-measure. Compare.</h1><p>Session-derived tips now carry forward into measured follow-up comparisons. “Improved” and “Worsened” apply only to recorded behavior or evidence-quality metrics—not random game outcomes.</p></div><div class="grid"><div class="card span12"><h2>Coaching comparisons</h2>${experiments.length?experiments.map(expCard).join(''):'<p class="muted">No coaching comparison yet. Record enough evidence for a session-derived recommendation, then record a later comparable session on the same platform.</p>'}</div><div class="card span12"><h2>Evidence-linked tips</h2>${rows.length?rows.map(t=>`<div class="feed-item"><div class="topline"><h3>${esc(t.title)}</h3><span class="pill">${esc(t.confidence)} confidence</span></div><p>${esc(t.body)}</p><p class="muted"><b>${esc(t.platform||'Session')}</b> · sample ${esc(t.sample_size||0)} · ${esc(t.evidence_type||'observed_evidence')}</p><details><summary>Why this tip exists</summary><p class="muted">Linked session #${esc(t.live_session_id||t.session_id)} · ${esc(t.started_at||t.created_at)}.</p><p class="muted">${esc(t.uncertainty||'This is evidence review, not a prediction of future random results.')}</p></details></div>`).join(''):'<p class="muted">No tips yet. Start or import a session first.</p>'}</div></div>`) }
