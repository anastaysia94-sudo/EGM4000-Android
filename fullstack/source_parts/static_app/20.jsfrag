// C008 A095 signed reconciliation controls for A082 marketplace + A083 white-label.
const _c008CommerceReconAdminBase=admin;
admin=async function(){
  await _c008CommerceReconAdminBase();
  if(!S.me||S.me.role!=='owner')return;
  const grid=document.querySelector('.content .grid');if(!grid)return;
  grid.insertAdjacentHTML('beforeend',`<div class="card span12"><div class="tag">A095 · Signed Commerce Reconciliation</div><h2>Marketplace & white-label provider links</h2><p class="muted">Use this only to map a provider customer reference to an existing marketplace order or white-label license target. This form does not verify payment. Provider verification occurs only when the deployment receives a correctly signed event at <code>/api/billing/commerce-provider-event</code>.</p><div class="grid"><div class="card span6"><label>Provider key</label><input id="c008CommerceProvider" placeholder="Provider identifier"><label>Provider customer reference</label><input id="c008CommerceCustomer" placeholder="Customer reference"><label>EGM4000 user ID</label><input id="c008CommerceUser" inputmode="numeric" placeholder="User ID"><label>Target</label><select id="c008CommerceTargetType"><option value="marketplace_order">Marketplace order</option><option value="white_label">White-label license</option></select><label>Target ID</label><input id="c008CommerceTarget" placeholder="Marketplace order ID, or same user ID for white-label"><button id="c008CommerceLink" class="aqua">Save signed-event mapping</button></div><div class="card span6"><h3>Accepted signed event types</h3><p><code>marketplace_paid</code> / <code>marketplace_reversed</code></p><p><code>white_label_active</code> / <code>white_label_cancelled</code></p><p class="muted">A valid HMAC signature is mandatory. Manual owner controls cannot write <code>provider_verified</code>.</p></div></div></div>`);
  document.querySelector('#c008CommerceLink').onclick=async()=>{try{const targetType=document.querySelector('#c008CommerceTargetType').value;const userId=Number(document.querySelector('#c008CommerceUser').value);const rawTarget=document.querySelector('#c008CommerceTarget').value.trim();await post('/api/admin/billing-commerce-link',{provider:document.querySelector('#c008CommerceProvider').value,customer_ref:document.querySelector('#c008CommerceCustomer').value,user_id:userId,target_type:targetType,target_id:targetType==='white_label'?(rawTarget||String(userId)):rawTarget});await admin()}catch(e){alert(e.message)}};
};