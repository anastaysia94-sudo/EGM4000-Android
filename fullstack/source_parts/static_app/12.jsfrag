// C008 A087 custom report packages: request intake, status tracking, and owner fulfillment.
const _c008ReportsTodayBase=today;
today=async function(){
  await _c008ReportsTodayBase();
  try{
    const catalog=await api('/api/custom-report-packages');
    if(!catalog.packages.length)return;
    const mine=S.me?await api('/api/my-custom-report-requests'):{requests:[]};
    const grid=document.querySelector('.content .grid');if(!grid)return;
    const packages=catalog.packages.map(p=>`<div class="event"><div class="topline"><b>${esc(p.title)}</b>${p.priceLabel?`<span class="pill">${esc(p.priceLabel)}</span>`:''}</div><p>${esc(p.description||'')}</p>${p.deliverables.length?`<ul>${p.deliverables.map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:''}${p.turnaroundLabel?`<p class="muted">Turnaround: ${esc(p.turnaroundLabel)}</p>`:''}<textarea class="c008-report-note" data-package="${esc(p.id)}" placeholder="What should this report focus on?"></textarea><button class="c008-report-request aqua" data-package="${esc(p.id)}">${S.me?'Request report':'Sign in to request'}</button></div>`).join('');
    const requests=mine.requests.length?mine.requests.map(r=>`<div class="event"><div class="topline"><b>${esc(r.packageTitle)}</b><span class="pill">${esc(r.status)}</span></div><p class="muted">Payment: ${esc(r.paymentStatus.replaceAll('_',' '))} · requested ${esc(r.createdAt)}</p>${r.deliveryNote?`<p>${esc(r.deliveryNote)}</p>`:''}${r.deliveryUrl?`<p><a href="${esc(r.deliveryUrl)}" target="_blank" rel="noopener noreferrer">Open delivered report ↗</a></p>`:''}</div>`).join(''):'<p class="muted">No custom report requests yet.</p>';
    grid.insertAdjacentHTML('beforeend',`<div class="card span12"><div class="tag">A087 · Custom Report Packages</div><h2>Request a human-reviewed custom evidence report</h2><p class="muted">${esc(catalog.billingBoundary)}</p><div class="grid"><div class="card span7">${packages}</div><div class="card span5"><h3>Your report requests</h3>${requests}</div></div></div>`);
    document.querySelectorAll('.c008-report-request').forEach(btn=>btn.onclick=async()=>{if(!S.me)return authScreen();const id=btn.dataset.package,note=document.querySelector(`.c008-report-note[data-package="${CSS.escape(id)}"]`).value;try{await post('/api/custom-report-request',{package_id:id,request_note:note});await today()}catch(e){alert(e.message)}});
  }catch(e){console.warn('custom report packages unavailable',e)}
};

const _c008ReportsAdminBase=admin;
admin=async function(){
  await _c008ReportsAdminBase();
  if(!S.me||S.me.role!=='owner')return;
  try{
    const [packages,requests]=await Promise.all([api('/api/admin/custom-report-packages'),api('/api/admin/custom-report-requests')]);
    const grid=document.querySelector('.content .grid');if(!grid)return;
    const packageRows=packages.packages.length?packages.packages.map(p=>`<div class="event c008-rp" data-json="${esc(encodeURIComponent(JSON.stringify(p)))}"><div class="topline"><b>${esc(p.title)}</b><span class="pill ${p.status==='active'?'good':''}">${esc(p.status)}</span></div><p class="muted">${esc(p.priceLabel||'No price label')} · ${esc(p.turnaroundLabel||'No turnaround')}</p><button class="c008-rp-edit">Edit</button></div>`).join(''):'<p class="muted">No report packages yet.</p>';
    const requestRows=requests.requests.length?requests.requests.map(r=>`<div class="event c008-rr" data-id="${esc(r.id)}"><div class="topline"><b>${esc(r.packageTitle)} · user #${esc(r.userId)}</b><span class="pill">${esc(r.status)}</span></div><p>${esc(r.requestNote||'No customer note')}</p><p class="muted">Payment: ${esc(r.paymentStatus.replaceAll('_',' '))}. EGM4000 does not self-certify external payment.</p><select class="c008-rr-status"><option ${r.status==='requested'?'selected':''}>requested</option><option ${r.status==='accepted'?'selected':''}>accepted</option><option ${r.status==='in_progress'?'selected':''}>in_progress</option><option ${r.status==='delivered'?'selected':''}>delivered</option><option ${r.status==='cancelled'?'selected':''}>cancelled</option></select><textarea class="c008-rr-owner" placeholder="Owner note">${esc(r.ownerNote||'')}</textarea><textarea class="c008-rr-delivery" placeholder="Customer-facing delivery note">${esc(r.deliveryNote||'')}</textarea><input class="c008-rr-url" placeholder="Optional HTTPS delivery URL" value="${esc(r.deliveryUrl||'')}"><button class="c008-rr-save aqua">Save request status</button></div>`).join(''):'<p class="muted">No customer report requests yet.</p>';
    grid.insertAdjacentHTML('beforeend',`<div class="card span12" id="c008ReportAdmin"><div class="tag">C008 · A087 Custom Report Package</div><h2>Report package storefront + fulfillment queue</h2><div class="grid"><div class="card span5"><input id="c008RpId" type="hidden"><label>Package title</label><input id="c008RpTitle" maxlength="180"><label>Description</label><textarea id="c008RpDescription" maxlength="3000"></textarea><label>Deliverables, one per line</label><textarea id="c008RpDeliverables"></textarea><label>Price label</label><input id="c008RpPrice" maxlength="120" placeholder="$49, Quote required…"><label>Turnaround</label><input id="c008RpTurnaround" maxlength="120" placeholder="Within 2 business days"><label>Status</label><select id="c008RpStatus"><option>draft</option><option>active</option><option>archived</option></select><div class="actions"><button id="c008RpSave" class="aqua">Save package</button><button id="c008RpClear">Clear</button></div><h3>Packages</h3>${packageRows}</div><div class="card span7"><div class="topline"><h3>Fulfillment queue</h3><span class="pill">${esc(requests.summary.open)} open · ${esc(requests.summary.delivered)} delivered</span></div>${requestRows}</div></div></div>`);
    const clear=()=>{document.querySelector('#c008RpId').value='';document.querySelector('#c008RpTitle').value='';document.querySelector('#c008RpDescription').value='';document.querySelector('#c008RpDeliverables').value='';document.querySelector('#c008RpPrice').value='';document.querySelector('#c008RpTurnaround').value='';document.querySelector('#c008RpStatus').value='draft'};
    document.querySelector('#c008RpClear').onclick=clear;
    document.querySelector('#c008RpSave').onclick=async()=>{const payload={id:document.querySelector('#c008RpId').value||undefined,title:document.querySelector('#c008RpTitle').value,description:document.querySelector('#c008RpDescription').value,deliverables:document.querySelector('#c008RpDeliverables').value,price_label:document.querySelector('#c008RpPrice').value,turnaround_label:document.querySelector('#c008RpTurnaround').value,status:document.querySelector('#c008RpStatus').value};try{await post('/api/admin/custom-report-package',payload);await admin()}catch(e){alert(e.message)}};
    document.querySelectorAll('.c008-rp-edit').forEach(btn=>btn.onclick=()=>{const p=JSON.parse(decodeURIComponent(btn.closest('.c008-rp').dataset.json));document.querySelector('#c008RpId').value=p.id;document.querySelector('#c008RpTitle').value=p.title;document.querySelector('#c008RpDescription').value=p.description||'';document.querySelector('#c008RpDeliverables').value=(p.deliverables||[]).join('\n');document.querySelector('#c008RpPrice').value=p.priceLabel||'';document.querySelector('#c008RpTurnaround').value=p.turnaroundLabel||'';document.querySelector('#c008RpStatus').value=p.status;document.querySelector('#c008ReportAdmin').scrollIntoView({behavior:'smooth'})});
    document.querySelectorAll('.c008-rr-save').forEach(btn=>btn.onclick=async()=>{const row=btn.closest('.c008-rr');const payload={id:row.dataset.id,status:row.querySelector('.c008-rr-status').value,payment_status:'external_unverified',owner_note:row.querySelector('.c008-rr-owner').value,delivery_note:row.querySelector('.c008-rr-delivery').value,delivery_url:row.querySelector('.c008-rr-url').value};try{await post('/api/admin/custom-report-request',payload);await admin()}catch(e){alert(e.message)}});
  }catch(e){console.warn('custom report admin unavailable',e)}
};
