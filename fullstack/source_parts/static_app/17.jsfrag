// C008 A072/A086/A088/A094/A095 metering, retention, coupon and reconciliation UI.
const _c008BillingTodayBase=today;
today=async function(){
  await _c008BillingTodayBase();
  if(!S.me)return;
  try{
    const b=await api('/api/billing/status');const grid=document.querySelector('.content .grid');if(!grid)return;
    let insights=null;if(b.retentionInsights.active){try{insights=await api('/api/commercial/retention-insights')}catch(e){}}
    const usage=b.usageCoaching.active?`<div class="event"><div class="topline"><b>A072 · Usage-based coaching</b><span class="pill">${esc(b.usageCoaching.remainingUnits)} / ${esc(b.usageCoaching.limitValue)} units left</span></div><textarea id="c008CoachContext" placeholder="What should this evidence digest focus on?"></textarea><button id="c008CoachConsume" class="aqua">Generate 1-unit evidence digest</button><div id="c008CoachResult"></div></div>`:'<div class="event"><b>A072 · Usage-based coaching</b><p class="muted">No active metered coaching access.</p></div>';
    const retention=insights?`<div class="event"><div class="topline"><b>A086 · Retention insights</b><span class="pill good">active</span></div><p>${esc(insights.activeDays)} recorded active days · ${esc(insights.activeDaysLast30)} in the latest 30-day window · longest observed gap ${esc(insights.longestObservedGapDays)} days</p><p class="muted">${esc(insights.boundary)}</p></div>`:'<div class="event"><b>A086 · Retention insights</b><p class="muted">No active retention-insights access.</p></div>';
    const archive=b.premiumRetention.active?`<div class="event"><div class="topline"><b>A088 · Premium evidence retention</b><span class="pill">${esc(b.premiumRetention.retainDays)} days</span></div><button id="c008ArchiveCreate" class="aqua">Create owned evidence archive</button><p class="muted">${esc(b.archives.length)} archive(s). Archives contain your own evidence only.</p>${b.archives.slice(0,5).map(a=>`<p><a href="#" class="c008-open-archive" data-id="${esc(a.id)}">${esc(a.id)}</a> · ${esc(a.rowCount)} rows · expires ${esc(a.expiresAt)}</p>`).join('')}<pre id="c008ArchivePreview" style="white-space:pre-wrap;max-height:260px;overflow:auto"></pre></div>`:'<div class="event"><b>A088 · Premium evidence retention</b><p class="muted">No active retention tier.</p></div>';
    grid.insertAdjacentHTML('beforeend',`<div class="card span12" id="c008BillingHub"><div class="tag">C008 · Metering & Billing Controls</div><h2>Metered tools, retention & offers</h2><p class="muted">${esc(b.boundary)}</p><div class="grid"><div class="card span6">${usage}${retention}</div><div class="card span6">${archive}<div class="event"><b>A094 · Trial / coupon</b><input id="c008CouponCode" placeholder="Coupon or trial code"><button id="c008CouponRedeem">Redeem</button><p id="c008CouponResult" class="muted"></p></div></div></div></div>`);
    const coach=document.querySelector('#c008CoachConsume');if(coach)coach.onclick=async()=>{try{const x=await post('/api/usage-coaching',{context:document.querySelector('#c008CoachContext').value});document.querySelector('#c008CoachResult').innerHTML=`<p class="muted">${esc(x.boundary)}</p>${x.tips.map(t=>`<div class="event"><b>${esc(t.title)}</b><p>${esc(t.body)}</p><span class="pill">${esc(t.confidence)}</span></div>`).join('')}`;coach.textContent=`Generate another (${x.status.remainingUnits} left)`}catch(e){alert(e.message)}};
    const arch=document.querySelector('#c008ArchiveCreate');if(arch)arch.onclick=async()=>{try{await post('/api/retention-archive',{});await today()}catch(e){alert(e.message)}};
    document.querySelectorAll('.c008-open-archive').forEach(a=>a.onclick=async ev=>{ev.preventDefault();try{const x=await api('/api/retention-archive?id='+encodeURIComponent(a.dataset.id));document.querySelector('#c008ArchivePreview').textContent=x.content}catch(e){alert(e.message)}});
    document.querySelector('#c008CouponRedeem').onclick=async()=>{try{const x=await post('/api/coupon/redeem',{code:document.querySelector('#c008CouponCode').value});document.querySelector('#c008CouponResult').textContent=x.redemption.billingBoundary||`${x.redemption.kind}: ${x.redemption.status}`;await today()}catch(e){alert(e.message)}};
  }catch(e){console.warn('billing controls unavailable',e)}
};

const _c008BillingAdminBase=admin;
admin=async function(){
  await _c008BillingAdminBase();
  if(!S.me||S.me.role!=='owner')return;
  try{
    const b=await api('/api/admin/billing-controls');const grid=document.querySelector('.content .grid');if(!grid)return;
    const access=b.addonAccess.slice(0,40).map(a=>`<div class="event"><b>${esc(a.display_name)} · ${esc(a.feature_id)}</b><span class="pill ${a.status==='active'?'good':''}">${esc(a.status)}</span><p class="muted">${esc(a.source)}${a.limit_value?` · limit ${esc(a.limit_value)}`:''}${a.retain_days?` · ${esc(a.retain_days)} days`:''}</p>${a.status==='active'?`<button class="c008-addon-revoke" data-user="${esc(a.user_id)}" data-feature="${esc(a.feature_id)}">Revoke</button>`:''}</div>`).join('')||'<p class="muted">No add-on grants yet.</p>';
    const coupons=b.coupons.map(c=>`<div class="event"><b>${esc(c.code)} · ${esc(c.title)}</b><span class="pill">${esc(c.kind)}</span><p class="muted">${esc(c.redemptions)}/${esc(c.max_redemptions)} redemptions · ${c.active?'active':'inactive'}</p></div>`).join('')||'<p class="muted">No coupons yet.</p>';
    const r=b.reconciliation;const events=r.events.slice(0,20).map(e=>`<div class="event"><b>${esc(e.provider)} · ${esc(e.event_type)}</b><span class="pill ${e.reconciliation_status==='reconciled'?'good':''}">${esc(e.reconciliation_status)}</span><p class="muted">event ${esc(e.provider_event_id)} · verification ${esc(e.verification_status)}</p></div>`).join('')||'<p class="muted">No provider events yet.</p>';
    grid.insertAdjacentHTML('beforeend',`<div class="card span12" id="c008BillingAdmin"><div class="tag">C008 · A072/A086/A088/A094/A095</div><h2>Metering, retention & reconciliation</h2><p class="muted">${esc(b.boundary)}</p><div class="grid"><div class="card span4"><h3>Add-on access</h3><input id="c008AddonUser" inputmode="numeric" placeholder="User ID"><select id="c008AddonFeature"><option value="A072">A072 Usage coaching</option><option value="A086">A086 Retention insights</option><option value="A088">A088 Premium retention</option></select><select id="c008AddonSource"><option>complimentary</option><option>external_unverified</option></select><input id="c008AddonLimit" type="number" placeholder="A072 units"><input id="c008AddonDays" type="number" placeholder="A088 retention days"><textarea id="c008AddonNote" placeholder="Provisioning note"></textarea><button id="c008AddonGrant" class="aqua">Grant add-on</button>${access}</div><div class="card span4"><h3>Trial / coupon control</h3><input id="c008CouponAdminCode" placeholder="CODE"><input id="c008CouponAdminTitle" placeholder="Offer title"><select id="c008CouponAdminKind"><option>trial_plan</option><option>feature_trial</option><option>coaching_units</option><option>retention_trial</option><option>discount</option></select><input id="c008CouponAdminPlan" placeholder="Target plan ID"><input id="c008CouponAdminFeature" placeholder="Target feature A072/A086/A088"><input id="c008CouponAdminTrial" type="number" placeholder="Trial days"><input id="c008CouponAdminUnits" type="number" placeholder="Unit bonus"><input id="c008CouponAdminRetention" type="number" placeholder="Retention days"><input id="c008CouponAdminDiscount" placeholder="Discount label"><input id="c008CouponAdminMax" type="number" value="1" min="1"><button id="c008CouponAdminSave" class="aqua">Save coupon</button>${coupons}</div><div class="card span4"><h3>A095 Provider reconciliation</h3><p><b>${esc(r.summary.reconciled)}</b> reconciled · <b>${esc(r.summary.unlinked)}</b> unlinked · <b>${esc(r.summary.targetMismatch)}</b> target mismatch</p><input id="c008BillProvider" placeholder="Provider key"><input id="c008BillCustomer" placeholder="Provider customer ref"><input id="c008BillUser" inputmode="numeric" placeholder="User ID"><select id="c008BillTargetType"><option>plan</option><option>feature</option></select><input id="c008BillTarget" placeholder="Plan ID or A072/A086/A088"><button id="c008BillLink" class="aqua">Save reconciliation link</button><p class="muted">${esc(r.boundary)}</p>${events}<button id="c008PruneArchives">Prune expired archives</button></div></div></div>`);
    document.querySelector('#c008AddonGrant').onclick=async()=>{try{await post('/api/admin/addon-access',{action:'grant',user_id:Number(document.querySelector('#c008AddonUser').value),feature_id:document.querySelector('#c008AddonFeature').value,source:document.querySelector('#c008AddonSource').value,limit_value:Number(document.querySelector('#c008AddonLimit').value)||undefined,retain_days:Number(document.querySelector('#c008AddonDays').value)||undefined,note:document.querySelector('#c008AddonNote').value});await admin()}catch(e){alert(e.message)}};
    document.querySelectorAll('.c008-addon-revoke').forEach(btn=>btn.onclick=async()=>{try{await post('/api/admin/addon-access',{action:'revoke',user_id:Number(btn.dataset.user),feature_id:btn.dataset.feature,note:'Revoked by owner'});await admin()}catch(e){alert(e.message)}});
    document.querySelector('#c008CouponAdminSave').onclick=async()=>{try{await post('/api/admin/coupon',{code:document.querySelector('#c008CouponAdminCode').value,title:document.querySelector('#c008CouponAdminTitle').value,kind:document.querySelector('#c008CouponAdminKind').value,target_plan_id:document.querySelector('#c008CouponAdminPlan').value||undefined,target_feature_id:document.querySelector('#c008CouponAdminFeature').value||undefined,trial_days:Number(document.querySelector('#c008CouponAdminTrial').value)||undefined,unit_bonus:Number(document.querySelector('#c008CouponAdminUnits').value)||undefined,retention_days:Number(document.querySelector('#c008CouponAdminRetention').value)||undefined,discount_label:document.querySelector('#c008CouponAdminDiscount').value,max_redemptions:Number(document.querySelector('#c008CouponAdminMax').value||1),active:true});await admin()}catch(e){alert(e.message)}};
    document.querySelector('#c008BillLink').onclick=async()=>{try{await post('/api/admin/billing-link',{provider:document.querySelector('#c008BillProvider').value,customer_ref:document.querySelector('#c008BillCustomer').value,user_id:Number(document.querySelector('#c008BillUser').value),target_type:document.querySelector('#c008BillTargetType').value,target_id:document.querySelector('#c008BillTarget').value});await admin()}catch(e){alert(e.message)}};
    document.querySelector('#c008PruneArchives').onclick=async()=>{try{const x=await post('/api/admin/retention-prune',{});alert(`Pruned ${x.deleted} expired archive(s).`);await admin()}catch(e){alert(e.message)}};
  }catch(e){console.warn('billing admin unavailable',e)}
};