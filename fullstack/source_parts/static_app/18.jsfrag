// C008 A082 creator/coach marketplace + A083 white-label licensing UI.
const _c008MarketTodayBase=today;
today=async function(){
  await _c008MarketTodayBase();
  try{
    const catalog=await api('/api/marketplace/catalog');const grid=document.querySelector('.content .grid');if(!grid)return;
    let mine={listings:[],purchases:[],sales:[]},wl=null;if(S.me){try{mine=await api('/api/marketplace/mine')}catch(e){};try{wl=await api('/api/white-label/status')}catch(e){}}
    const listings=catalog.listings.map(l=>`<div class="event"><div class="topline"><b>${esc(l.title)}</b><span class="pill">${esc(l.coachName)}</span></div><p>${esc(l.description||'')}</p><p class="muted">${esc(l.serviceLabel||'Coach service')} · $${esc((l.priceCents/100).toFixed(2))} · platform fee ${esc(l.platformFeePercent)}%</p>${S.me&&l.coachUserId!==S.me.id?`<textarea class="c008-order-note" data-listing="${esc(l.id)}" placeholder="What evidence should the coach review?"></textarea><button class="c008-order aqua" data-listing="${esc(l.id)}">Request service</button>`:''}</div>`).join('')||'<p class="muted">No active coach listings yet.</p>';
    const purchases=mine.purchases.map(o=>`<div class="event"><b>${esc(o.title)}</b><span class="pill">${esc(o.status)}</span><p class="muted">Coach ${esc(o.coachName)} · payment ${esc(o.paymentStatus.replaceAll('_',' '))} · fee $${esc((o.platformFeeCents/100).toFixed(2))}</p>${o.deliveryNote?`<p>${esc(o.deliveryNote)}</p>`:''}</div>`).join('')||'<p class="muted">No service requests.</p>';
    const sales=mine.sales.map(o=>`<div class="event c008-market-sale" data-id="${esc(o.id)}"><b>${esc(o.title)} · ${esc(o.buyerName)}</b><span class="pill">${esc(o.status)}</span><p>${esc(o.requestNote||'No request note')}</p><p class="muted">Payment ${esc(o.paymentStatus.replaceAll('_',' '))}. Gross $${esc((o.grossCents/100).toFixed(2))}, fee $${esc((o.platformFeeCents/100).toFixed(2))}, creator ledger net $${esc((o.creatorNetCents/100).toFixed(2))}.</p><select class="c008-sale-status"><option ${o.status==='requested'?'selected':''}>requested</option><option ${o.status==='accepted'?'selected':''}>accepted</option><option ${o.status==='in_progress'?'selected':''}>in_progress</option><option ${o.status==='delivered'?'selected':''}>delivered</option><option ${o.status==='cancelled'?'selected':''}>cancelled</option></select><textarea class="c008-sale-delivery" placeholder="Delivery note">${esc(o.deliveryNote||'')}</textarea><button class="c008-sale-save">Save status</button></div>`).join('')||'<p class="muted">No incoming marketplace requests.</p>';
    const creator=S.me?`<div class="card span4"><h3>Create coach listing</h3><input id="c008MarketId" type="hidden"><input id="c008MarketTitle" placeholder="Service title"><textarea id="c008MarketDesc" placeholder="What you provide"></textarea><input id="c008MarketLabel" placeholder="Service label"><input id="c008MarketPrice" type="number" min="100" placeholder="Price in cents"><input id="c008MarketFee" type="number" min="0" max="5000" value="1500" placeholder="Fee basis points"><select id="c008MarketStatus"><option>draft</option><option>active</option><option>archived</option></select><button id="c008MarketSave" class="aqua">Save listing</button><p class="muted">${esc(catalog.safetyBoundary)}</p>${sales}</div>`:'';
    let white='';if(S.me){white=`<div class="card span4"><div class="tag">A083 · White-label License</div><h3>Licensed presentation</h3>${wl&&wl.license.active?`<input id="c008WlBrand" placeholder="Brand name" value="${esc(wl.profile?.brand_name||'')}"><input id="c008WlLogo" placeholder="Optional HTTPS logo URL" value="${esc(wl.profile?.logo_url||'')}"><input id="c008WlSupport" placeholder="Support label" value="${esc(wl.profile?.support_label||'')}"><input id="c008WlAccent" placeholder="Accent label" value="${esc(wl.profile?.accent_label||'')}"><textarea id="c008WlFooter" placeholder="Footer text">${esc(wl.profile?.footer_text||'')}</textarea><button id="c008WlSave" class="aqua">Save brand profile</button><button id="c008WlPreview">Preview license</button><div id="c008WlPreviewOut"></div>`:`<p class="muted">No active white-label license.</p>`}<p class="muted">${esc(wl?.boundary||'Presentation licensing does not change evidence or random outcomes.')}</p></div>`}
    grid.insertAdjacentHTML('beforeend',`<div class="card span12"><div class="tag">C008 · A082 Marketplace / A083 White-label</div><h2>Coach marketplace & licensed presentation</h2><p class="muted">${esc(catalog.feeBoundary)}</p><div class="grid"><div class="card ${S.me?'span4':'span12'}"><h3>Coach services</h3>${listings}</div>${S.me?`<div class="card span4"><h3>Your requests</h3>${purchases}</div>${creator}${white}`:''}</div></div>`);
    document.querySelectorAll('.c008-order').forEach(btn=>btn.onclick=async()=>{try{const id=btn.dataset.listing,note=document.querySelector(`.c008-order-note[data-listing="${CSS.escape(id)}"]`).value;await post('/api/marketplace/order',{listing_id:id,note});await today()}catch(e){alert(e.message)}});
    const save=document.querySelector('#c008MarketSave');if(save)save.onclick=async()=>{try{await post('/api/marketplace/listing',{id:document.querySelector('#c008MarketId').value||undefined,title:document.querySelector('#c008MarketTitle').value,description:document.querySelector('#c008MarketDesc').value,service_label:document.querySelector('#c008MarketLabel').value,price_cents:Number(document.querySelector('#c008MarketPrice').value),platform_fee_bps:Number(document.querySelector('#c008MarketFee').value||1500),status:document.querySelector('#c008MarketStatus').value});await today()}catch(e){alert(e.message)}};
    document.querySelectorAll('.c008-sale-save').forEach(btn=>btn.onclick=async()=>{const row=btn.closest('.c008-market-sale');try{await post('/api/marketplace/order-status',{id:row.dataset.id,status:row.querySelector('.c008-sale-status').value,delivery_note:row.querySelector('.c008-sale-delivery').value});await today()}catch(e){alert(e.message)}});
    const wls=document.querySelector('#c008WlSave');if(wls)wls.onclick=async()=>{try{await post('/api/white-label/profile',{brand_name:document.querySelector('#c008WlBrand').value,logo_url:document.querySelector('#c008WlLogo').value,support_label:document.querySelector('#c008WlSupport').value,accent_label:document.querySelector('#c008WlAccent').value,footer_text:document.querySelector('#c008WlFooter').value});await today()}catch(e){alert(e.message)}};
    const wlp=document.querySelector('#c008WlPreview');if(wlp)wlp.onclick=async()=>{try{const p=await api('/api/white-label/preview');document.querySelector('#c008WlPreviewOut').innerHTML=`<div class="event"><div class="topline"><b>${esc(p.brandName)}</b><span class="pill">licensed preview</span></div>${p.logoUrl?`<p><img src="${esc(p.logoUrl)}" alt="" style="max-width:120px;max-height:60px"></p>`:''}<p>${esc(p.supportLabel||'')}</p><p>${esc(p.footerText||'')}</p><p class="muted">${esc(p.boundary)} · ${esc(p.poweredBy)}</p></div>`}catch(e){alert(e.message)}};
  }catch(e){console.warn('marketplace/licensing unavailable',e)}
};

const _c008MarketAdminBase=admin;
admin=async function(){
  await _c008MarketAdminBase();
  if(!S.me||S.me.role!=='owner')return;
  try{
    const [m,w]=await Promise.all([api('/api/admin/marketplace'),api('/api/admin/white-label')]);const grid=document.querySelector('.content .grid');if(!grid)return;
    const orders=m.orders.slice(0,30).map(o=>`<div class="event"><b>${esc(o.title)}</b><span class="pill ${o.paymentStatus==='provider_verified'?'good':''}">${esc(o.paymentStatus)}</span><p>${esc(o.coachName)} ← ${esc(o.buyerName)} · gross $${esc((o.grossCents/100).toFixed(2))} · platform fee $${esc((o.platformFeeCents/100).toFixed(2))}</p></div>`).join('')||'<p class="muted">No marketplace orders.</p>';
    const licenses=w.licenses.map(l=>`<div class="event"><b>${esc(l.display_name)}</b><span class="pill ${l.status==='active'?'good':''}">${esc(l.status)}</span><p class="muted">${esc(l.source)} · ${esc(l.brand_name||'No brand profile')}</p>${l.status==='active'?`<button class="c008-wl-revoke" data-user="${esc(l.user_id)}">Revoke</button>`:''}</div>`).join('')||'<p class="muted">No white-label licenses.</p>';
    grid.insertAdjacentHTML('beforeend',`<div class="card span12"><div class="tag">C008 · A082 / A083 Owner Controls</div><h2>Marketplace fee ledger & white-label licenses</h2><div class="grid"><div class="card span6"><h3>A082 marketplace fee ledger</h3><p><b>${esc(m.summary.orders)}</b> orders · <b>${esc(m.summary.providerVerified)}</b> provider verified · verified platform fee ledger $${esc((m.summary.verifiedPlatformFeeCents/100).toFixed(2))}</p><p class="muted">${esc(m.boundary)}</p>${orders}</div><div class="card span6"><h3>A083 white-label licensing</h3><input id="c008WlUser" inputmode="numeric" placeholder="User ID"><select id="c008WlSource"><option>complimentary</option><option>external_unverified</option></select><textarea id="c008WlNote" placeholder="License note"></textarea><button id="c008WlGrant" class="aqua">Grant license</button><p class="muted">${esc(w.boundary)}</p>${licenses}</div></div></div>`);
    document.querySelector('#c008WlGrant').onclick=async()=>{try{await post('/api/admin/white-label-license',{action:'grant',user_id:Number(document.querySelector('#c008WlUser').value),source:document.querySelector('#c008WlSource').value,note:document.querySelector('#c008WlNote').value});await admin()}catch(e){alert(e.message)}};
    document.querySelectorAll('.c008-wl-revoke').forEach(btn=>btn.onclick=async()=>{try{await post('/api/admin/white-label-license',{action:'revoke',user_id:Number(btn.dataset.user),note:'Revoked by owner'});await admin()}catch(e){alert(e.message)}});
  }catch(e){console.warn('marketplace/licensing admin unavailable',e)}
};