async function community(){let threads=await api('/api/community/threads'),posts=await api('/api/blog/posts');shell(`<div class="hero"><div class="tag">Community + Editorial</div><h1>The session room.</h1><p>Discuss evidence, ask for interpretation, publish longer write-ups, and report bad content. Synthetic seeded accounts are labeled in the database and never represented as real customers.</p></div><div class="card"><div class="tabs"><button class="tab ${S.communityTab==='forum'?'active':''}" data-ct="forum">Forum</button><button class="tab ${S.communityTab==='blog'?'active':''}" data-ct="blog">Blog</button>${S.me?'<button class="tab" id="createCommunity">Create</button>':''}</div><div id="feed">${S.communityTab==='forum'?threads.map(t=>`<div class="feed-item"><div class="topline"><h3><button class="linkish" data-thread="${t.id}">${esc(t.title)}</button></h3><span class="pill">${esc(t.category)}</span></div><p>${esc(t.body)}</p><p class="muted">${esc(t.display_name)} · ${t.reply_count} replies</p>${S.me?`<button class="danger report" data-tt="forum_thread" data-id="${t.id}">Report</button>`:''}</div>`).join(''):posts.map(p=>`<div class="feed-item"><div class="topline"><h3><button data-post="${p.id}">${esc(p.title)}</button></h3><span class="pill">${p.comment_count} comments</span></div><p>${esc(p.body)}</p><p class="muted">${esc(p.display_name)} · ${esc(p.tags)}</p>${S.me?`<button class="danger report" data-tt="blog_post" data-id="${p.id}">Report</button>`:''}</div>`).join('')}</div></div>`);document.querySelectorAll('[data-ct]').forEach(b=>b.onclick=()=>{S.communityTab=b.dataset.ct;community()});document.querySelectorAll('[data-thread]').forEach(b=>b.onclick=()=>threadDetail(+b.dataset.thread));document.querySelectorAll('[data-post]').forEach(b=>b.onclick=()=>postDetail(+b.dataset.post));document.querySelectorAll('.report').forEach(b=>b.onclick=()=>report(b.dataset.tt,+b.dataset.id));let c=document.querySelector('#createCommunity');if(c)c.onclick=createCommunity}
function createCommunity(){let type=S.communityTab;let box=document.querySelector('#feed');box.innerHTML=`<div class="card"><h2>${type==='forum'?'New forum thread':'Submit blog post'}</h2><input id="ctitle" placeholder="Title"><textarea id="cbody" placeholder="Write something useful and evidence-aware."></textarea>${type==='forum'?'<input id="ccat" placeholder="Category" value="Session Review">':'<input id="ctags" placeholder="Tags">'}<button class="aqua" id="csave">Publish / submit</button><p id="cmsg"></p></div>`;csave.onclick=async()=>{try{let r=type==='forum'?await post('/api/community/thread',{title:ctitle.value,body:cbody.value,category:ccat.value}):await post('/api/blog/post',{title:ctitle.value,body:cbody.value,tags:ctags.value});cmsg.className='good';cmsg.textContent=type==='forum'?'Published.':`Submitted with status: ${r.status}`;setTimeout(community,700)}catch(e){cmsg.className='warn';cmsg.textContent=e.message}}}
async function threadDetail(id){let x=await api('/api/community/thread?id='+id);let t=x.thread;if(!t)return;let feed=document.querySelector('#feed');feed.innerHTML=`<button id="backCommunity">← Back</button><div class="feed-item"><h2>${esc(t.title)}</h2><p>${esc(t.body)}</p><p class="muted">${esc(t.display_name)}</p></div>${x.replies.map(r=>`<div class="event"><b>${esc(r.display_name)}</b><p>${esc(r.body)}</p></div>`).join('')}${S.me?'<textarea id="replyBody" placeholder="Reply"></textarea><button class="aqua" id="replySave">Reply</button>':''}`;backCommunity.onclick=community;let r=document.querySelector('#replySave');if(r)r.onclick=async()=>{await post('/api/community/reply',{thread_id:id,body:replyBody.value});threadDetail(id)}}
async function postDetail(id){let x=await api('/api/blog/post?id='+id);let p=x.post;if(!p)return;let feed=document.querySelector('#feed');feed.innerHTML=`<button id="backCommunity">← Back</button><div class="feed-item"><h2>${esc(p.title)}</h2><p>${esc(p.body)}</p><p class="muted">${esc(p.display_name)} · ${esc(p.tags)}</p></div>${x.comments.map(r=>`<div class="event"><b>${esc(r.display_name)}</b><p>${esc(r.body)}</p></div>`).join('')}${S.me?'<textarea id="commentBody" placeholder="Comment"></textarea><button class="aqua" id="commentSave">Comment</button>':''}`;backCommunity.onclick=community;let r=document.querySelector('#commentSave');if(r)r.onclick=async()=>{await post('/api/blog/comment',{post_id:id,body:commentBody.value});postDetail(id)}}
async function report(tt,id){let reason=prompt('What should the owner review?','Potential spam or misleading claim');if(!reason)return;try{await post('/api/report',{target_type:tt,target_id:id,reason});alert('Report sent to the moderation queue.')}catch(e){alert(e.message)}}
