const A=document.querySelector('#app');
let S={me:null,csrf:null,view:'today',sid:null,platform:'fire-kirin',communityTab:'forum'};
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
async function api(u,o={}){o.headers={'Content-Type':'application/json',...(o.headers||{})};if(S.csrf&&o.method&&o.method!=='GET')o.headers['X-CSRF-Token']=S.csrf;let r=await fetch(u,o),j=await r.json().catch(()=>({}));if(!r.ok)throw Error(j.error||'request_failed');return j}
const post=(u,b)=>api(u,{method:'POST',body:JSON.stringify(b)});
function navButton(id,label){return `<button data-view="${id}" class="${S.view===id?'active':''}">${label}</button>`}
function shell(body){A.innerHTML=`<div class="shell"><aside class="side"><div class="tag">Gameplay Intelligence</div><div class="brand">EGM<b>4000</b></div><p class="muted">Watch. Measure. Explain. Improve.</p><div class="nav">${navButton('today','◉ Today')}${navButton('tips','✦ Tips')}${navButton('community','◎ Community')}${navButton('surveys','◈ Surveys')}${navButton('live','⌁ Live Lab')}${S.me?.role==='owner'?navButton('admin','⚙ Admin'):''}</div><div class="card" style="margin-top:16px"><span class="status-dot"></span><b>${esc(S.me?.display_name||'Guest')}</b><p class="muted">${esc(S.me?.role||'Public visitor')}</p>${S.me?'<button id="logout">Sign out</button>':'<button id="signin">Sign in / register</button>'}</div></aside><section class="content">${body}<div class="footer">EGM4000 uses user-authorized evidence. Estimates are labeled. No profit or random-outcome guarantee.</div></section></div>`;bindShell()}
function bindShell(){document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{S.view=b.dataset.view;render()});let lo=document.querySelector('#logout');if(lo)lo.onclick=async()=>{await post('/api/logout',{});S.me=null;S.csrf=null;S.view='today';await boot()};let si=document.querySelector('#signin');if(si)si.onclick=()=>authScreen()}
async function boot(){let m=await api('/api/me');S.me=m.authenticated?m.user:null;S.csrf=m.csrf||null;if(!localStorage.getItem('egm4000.tutorial.done'))tutorial();await render();if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js').catch(()=>{})}
function tutorial(){let d=document.createElement('div');d.className='tutorial';d.innerHTML=`<div class="card"><div class="tag">First-run tutorial</div><h2>How EGM4000 works</h2><div id="tstep"><p><b>1 · Play normally.</b> EGM4000 never needs your third-party game password.</p><p><b>2 · Record or authorize evidence.</b> Manual observations are exact only when you verify them; motion/vision signals remain estimates until confirmed.</p><p><b>3 · Review Tips + Replay.</b> Coaching is tied to evidence and confidence, not lucky-streak claims.</p><p><b>4 · Use Community + Surveys.</b> Registered users can discuss sessions; surveys use a pseudonymous visitor token rather than storing raw IP addresses.</p><p><b>5 · Set limits.</b> A losing session is not evidence the next outcome is “due.”</p></div><div class="actions"><button class="aqua" id="tdone">Enter Command Center</button></div></div>`;document.body.appendChild(d);d.querySelector('#tdone').onclick=()=>{localStorage.setItem('egm4000.tutorial.done','1');d.remove()}}
