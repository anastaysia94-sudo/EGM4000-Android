const A=document.querySelector('#app');
let S={me:null,csrf:null,view:'today',sid:null,platform:'fire-kirin',communityTab:'forum'};
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
async function api(u,o={}){o.headers={'Content-Type':'application/json',...(o.headers||{})};if(S.csrf&&o.method&&o.method!=='GET')o.headers['X-CSRF-Token']=S.csrf;let r=await fetch(u,o),j=await r.json().catch(()=>({}));if(!r.ok)throw Error(j.error||'request_failed');return j}
const post=(u,b)=>api(u,{method:'POST',body:JSON.stringify(b)});
function navButton(id,label){return `<button data-view="${id}" class="${S.view===id?'active':''}">${label}</button>`}
function shell(body){A.innerHTML=`<div class="shell"><aside class="side"><div class="tag">Gameplay Intelligence</div><div class="brand">EGM<b>4000</b></div><p class="muted">Watch. Measure. Explain. Improve.</p><div class="nav">${navButton('today','◉ Today')}${navButton('tips','✦ Tips')}${navButton('community','◎ Community')}${navButton('surveys','◈ Surveys')}${navButton('live','⌁ Live Lab')}${S.me?.role==='owner'?navButton('admin','⚙ Admin'):''}</div><div class="card" style="margin-top:16px"><span class="status-dot"></span><b>${esc(S.me?.display_name||'Guest')}</b><p class="muted">${esc(S.me?.role||'Public visitor')}</p>${S.me?'<button id="logout">Sign out</button>':'<button id="signin">Sign in / register</button>'}<button id="tutorialReplay" style="margin-top:8px">? Guided tutorial</button></div></aside><section class="content">${body}<div class="footer">EGM4000 uses user-authorized evidence. Estimates are labeled. No profit or random-outcome guarantee.</div></section></div>`;bindShell()}
function bindShell(){document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>{S.view=b.dataset.view;render()});let lo=document.querySelector('#logout');if(lo)lo.onclick=async()=>{await post('/api/logout',{});S.me=null;S.csrf=null;S.view='today';await boot()};let si=document.querySelector('#signin');if(si)si.onclick=()=>authScreen();let tr=document.querySelector('#tutorialReplay');if(tr)tr.onclick=()=>tutorial(true)}
const VIEW_FEATURES={today:'R001',tips:'R005',community:'R042',surveys:'R048',live:'R002'};
function trackReturn(feature,event_name='view',context={}){if(!S.me||!S.csrf)return;post('/api/return/event',{feature_id:feature,event_name,context}).catch(()=>{})}
async function boot(){let m=await api('/api/me');S.me=m.authenticated?m.user:null;S.csrf=m.csrf||null;if(!localStorage.getItem('egm4000.tutorial.done'))tutorial(false);await render();if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js').catch(()=>{})}
const TUTORIAL_STEPS=[
 {key:'setup',title:'1 · Set up your EGM4000 workspace',body:'Choose the game/platform you are analyzing and use EGM4000 as a companion. Third-party credentials stay with the provider. EGM4000 should only receive data you intentionally record, import, or authorize.',view:'today',action:'Open Today'},
 {key:'logging',title:'2 · Log a session',body:'Start a session and record observations such as shots, credit movement, breaks, target activity, weapon level, or other supported evidence. Manual entries are treated as user-recorded evidence, not magical truth beamed down from the casino heavens.',view:'today',action:'Open session tools'},
 {key:'monitoring',title:'3 · Monitor authorized events',body:'Live Lab can work with user-authorized capture or supported telemetry. Visual or inferred signals remain estimates until verified; raw third-party passwords and hidden server state are outside the product boundary.',view:'live',action:'Open Live Lab'},
 {key:'analytics',title:'4 · Read analytics and replay',body:'Use session metrics, timelines, baselines, and replay to understand what happened in your own history. A pattern is evidence about recorded sessions, not a guarantee that the next random event will repeat it.',view:'today',action:'Open analytics'},
 {key:'tips',title:'5 · Use AI-assisted Tips',body:'Tips must point back to evidence and show uncertainty or confidence. Prefer guidance such as pacing, stopping, review, and consistency checks over claims that a particular target or timing is “due.”',view:'tips',action:'Open Tips Center'},
 {key:'bankroll',title:'6 · Use Bankroll Guard',body:'Set personal session limits and treat stop-loss, time, and pace warnings as guardrails. EGM4000 can help you follow limits; it cannot turn negative variance into a predictable future win.',view:'today',action:'Open guardrails'},
 {key:'community',title:'7 · Use Community carefully',body:'Registered users can discuss sessions, post observations, comment, and report content. Community claims stay user-generated unless separately supported by evidence. Owner moderation protects the space without converting opinions into verified facts.',view:'community',action:'Open Community'},
 {key:'privacy',title:'8 · Control privacy and surveys',body:'Survey targeting distinguishes first, returning, and registered users with consent-aware, privacy-preserving identifiers. Review what you share before importing, exporting, posting, or authorizing capture.',view:'surveys',action:'Open Privacy & Surveys'},
 {key:'research',title:'9 · Keep Research Lab safe',body:'Research is for local, original, owned, or explicitly authorized sandboxes, reverse-engineering education, AI experiments, and defensive anti-cheat study. Do not bypass protections, manipulate real balances, or compromise live third-party services.',view:'live',action:'Open safe Research Lab'}
];
function tutorial(force=false){
 if(document.querySelector('.tutorial'))return;
 const done=localStorage.getItem('egm4000.tutorial.done')==='1';
 if(done&&!force)return;
 let step=force?0:Math.max(0,Math.min(TUTORIAL_STEPS.length-1,Number(localStorage.getItem('egm4000.tutorial.step')||0)));
 let d=document.createElement('div');d.className='tutorial';d.setAttribute('role','dialog');d.setAttribute('aria-modal','true');d.setAttribute('aria-labelledby','tutorialTitle');document.body.appendChild(d);
 const close=(completed=false)=>{if(completed){localStorage.setItem('egm4000.tutorial.done','1');localStorage.removeItem('egm4000.tutorial.step')}d.remove();document.removeEventListener('keydown',keys)};
 const jump=st=>{S.view=st.view;close(false);render()};
 const draw=()=>{let st=TUTORIAL_STEPS[step];localStorage.setItem('egm4000.tutorial.step',String(step));let pct=Math.round(((step+1)/TUTORIAL_STEPS.length)*100);d.innerHTML=`<div class="card tutorial-card"><div class="tutorial-top"><div><div class="tag">C002 · First-run tutorial</div><h2 id="tutorialTitle">${esc(st.title)}</h2></div><button id="tclose" aria-label="Close tutorial">×</button></div><div class="tutorial-progress" aria-label="Tutorial progress"><span style="width:${pct}%"></span></div><div class="tutorial-count">Step ${step+1} of ${TUTORIAL_STEPS.length} · ${pct}%</div><p class="tutorial-copy">${esc(st.body)}</p><div class="stepdots" aria-hidden="true">${TUTORIAL_STEPS.map((_,i)=>`<span class="${i===step?'on':''}"></span>`).join('')}</div><div class="actions"><button id="tback" ${step===0?'disabled':''}>Back</button><button id="tjump">${esc(st.action)}</button><button class="aqua" id="tnext">${step===TUTORIAL_STEPS.length-1?'Finish tutorial':'Next'}</button><button id="tskip">Skip for now</button></div><p class="muted" style="margin-top:12px">Keyboard: ←/→ to move, Esc to close. Progress resumes on this browser until completed.</p></div>`;
 d.querySelector('#tclose').onclick=()=>close(false);d.querySelector('#tskip').onclick=()=>close(false);d.querySelector('#tjump').onclick=()=>jump(st);d.querySelector('#tback').onclick=()=>{if(step>0){step--;draw()}};d.querySelector('#tnext').onclick=()=>{if(step<TUTORIAL_STEPS.length-1){step++;draw()}else close(true)};d.querySelector('#tnext').focus();
 };
 const keys=e=>{if(!document.body.contains(d))return;if(e.key==='Escape')close(false);if(e.key==='ArrowRight'){e.preventDefault();if(step<TUTORIAL_STEPS.length-1){step++;draw()}else close(true)}if(e.key==='ArrowLeft'&&step>0){e.preventDefault();step--;draw()}};
 document.addEventListener('keydown',keys);draw();
}
