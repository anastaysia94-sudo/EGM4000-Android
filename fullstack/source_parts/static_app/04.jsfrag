async function surveys(){let x=await api('/api/surveys/active');shell(`<div class="hero"><div class="tag">Privacy-safe Surveys</div><h1>Your feedback without a raw-IP profile.</h1><p>EGM4000 uses a pseudonymous visitor token and a one-way network hash for first/returning targeting. Raw IP addresses are not stored in the survey tables.</p></div><div class="grid"><div class="card span4"><h2>Consent</h2><p class="muted">Survey participation is optional.</p><button class="aqua" id="consentYes">Allow survey responses</button><button id="consentNo">Decline</button><p>Current: <b>${x.consent?'allowed':'not allowed'}</b></p></div><div class="card span8"><h2>${esc(x.audience)} visitor surveys</h2><div id="surveyList">${x.surveys.length?x.surveys.map(s=>surveyCard(s,x.consent)).join(''):'<p class="muted">No survey is targeting this visit right now.</p>'}</div></div></div>`);consentYes.onclick=async()=>{await post('/api/survey/consent',{consent:true});surveys()};consentNo.onclick=async()=>{await post('/api/survey/consent',{consent:false});surveys()};document.querySelectorAll('[data-survey-submit]').forEach(b=>b.onclick=()=>submitSurvey(+b.dataset.surveySubmit))}
function surveyCard(s,consent){return `<div class="feed-item" data-survey="${s.id}"><h3>${esc(s.title)}</h3><p class="muted">${esc(s.description)}</p>${s.questions.map(q=>question(q)).join('')}<button class="aqua" data-survey-submit="${s.id}" ${consent?'':'disabled'}>Submit response</button></div>`}
function question(q){let opts=[];try{opts=JSON.parse(q.options_json||'[]')}catch{}if(q.kind==='choice')return `<label>${esc(q.prompt)}<select data-q="${q.id}">${opts.map(o=>`<option>${esc(o)}</option>`).join('')}</select></label>`;if(q.kind==='scale')return `<label>${esc(q.prompt)}<input data-q="${q.id}" type="range" min="1" max="5" value="3"></label>`;return `<label>${esc(q.prompt)}<textarea data-q="${q.id}"></textarea></label>`}
async function submitSurvey(id){let box=document.querySelector(`[data-survey="${id}"]`),answers={};box.querySelectorAll('[data-q]').forEach(el=>answers[el.dataset.q]=el.value);try{await post('/api/survey/respond',{survey_id:id,answers});box.innerHTML='<h3 class="good">Thank you — response saved.</h3>'}catch(e){alert(e.message)}}
async function live(){if(!S.me)return authScreen();let ads=await api('/api/adapters');shell(`<div class="hero"><div class="tag">Live Lab</div><h1>Capture what you can prove.</h1><p>Third-party adapters are read-only evidence profiles. Manual buttons represent user-verified visible events; motion remains an estimate.</p></div><div class="grid"><div class="card span8"><select id="platform">${ads.map(x=>`<option value="${esc(x.id)}">${esc(x.name)} · ${esc(x.mode)}</option>`).join('')}</select><div class="actions"><button class="aqua" id="start">Start authorized session</button><button data-e="shot_fired">Verified shot</button><button data-e="target_hit">Verified hit</button><button data-e="target_destroyed">Verified destroy</button><button id="motion">Motion estimate</button><button id="replay">Replay</button></div><div id="livebox"></div></div><div class="card span4"><h2>Evidence legend</h2><p><span class="pill">observed_evidence</span> You verified it.</p><p><span class="pill">estimate</span> EGM inferred a visible signal.</p><p><span class="pill">correlation</span> Two things moved together.</p><p><span class="pill">exact_telemetry</span> Authorized exact source such as owned F.S.A.</p></div></div>`);platform.onchange=()=>S.platform=platform.value;S.platform=platform.value;start.onclick=async()=>{let x=await post('/api/live/start',{platform:S.platform});S.sid=x.session_id;livebox.innerHTML=`<p class="pill">session ${S.sid}</p>`};document.querySelectorAll('[data-e]').forEach(b=>b.onclick=()=>emit(b.dataset.e,'observed_evidence',1,{}));motion.onclick=()=>emit('motion_sample','estimate',.65,{motion:Math.random()*.2});replay.onclick=async()=>{let rows=await api('/api/live/replay');livebox.innerHTML=rows.slice(0,100).map(x=>`<div class="event"><b>${esc(x.event_type)}</b> <span class="pill">${esc(x.evidence_type)}</span> ${Math.round(x.confidence*100)}%<br><span class="muted">${esc(x.platform)} · ${esc(x.event_time)}</span></div>`).join('')}}
async function emit(type,evidence_type,confidence,payload){if(!S.sid)return alert('Start a session first.');let x=await post('/api/live/event',{session_id:S.sid,platform:S.platform,type,evidence_type,confidence,payload});livebox.innerHTML=`<div class="event"><b>${esc(type)}</b> · ${esc(evidence_type)}<br><span class="muted">events ${x.metrics.events} · shots ${x.metrics.shots} · hits ${x.metrics.hits} · kills ${x.metrics.kills} · hit rate ${(x.metrics.hit_rate*100).toFixed(1)}%</span></div>`+livebox.innerHTML}
