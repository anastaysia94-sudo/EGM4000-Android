
const _adminBase=admin;
admin=async function(){await _adminBase();if(!S.me||S.me.role!=='owner')return;try{let [trends,quality,adapters]=await Promise.all([api('/api/admin/coaching-trends'),api('/api/admin/evidence-quality'),api('/api/admin/adapter-health')]);let grid=document.querySelector('.content .grid');if(!grid)return;let trendRows=trends.rows.length?trends.rows.map(r=>`<div class="event"><b>${esc(r.platform)} · ${esc(r.target_metric)}</b><p class="muted">${esc(r.result)} · n=${esc(r.count)} · avg confidence ${Math.round(Number(r.avg_confidence||0)*100)}%</p></div>`).join(''):'<p class="muted">No completed coaching comparisons yet.</p>';let qualityRows=quality.by_evidence_type.length?quality.by_evidence_type.map(r=>`<div class="event"><b>${esc(r.evidence_type)}</b><p class="muted">events ${esc(r.events)} · sessions ${esc(r.sessions)} · avg confidence ${Math.round(Number(r.avg_confidence||0)*100)}%</p></div>`).join(''):'<p class="muted">No normalized evidence yet.</p>';let adapterRows=adapters.adapters.map(a=>`<div class="event"><div class="topline"><b>${esc(a.name)}</b><span class="pill ${a.state==='ready'?'good':'warn'}">${esc(a.state.replaceAll('_',' '))}</span></div><p class="muted">${esc(a.mode)} · sessions ${esc(a.sessions)} · events ${esc(a.events)}</p></div>`).join('');grid.insertAdjacentHTML('beforeend',`<div class="card span4"><h2>Cross-session coaching trends</h2><p class="muted">${trends.completed}/${trends.total} experiments completed. Behavior/evidence metrics only.</p>${trendRows}</div><div class="card span4"><h2>Evidence-quality diagnostics</h2><p class="muted">${quality.total_events} normalized events.</p>${qualityRows}</div><div class="card span4"><h2>Adapter health</h2><p class="muted">Exact telemetry remains restricted to authenticated owned F.S.A.</p>${adapterRows}</div>`) }catch(e){console.warn('admin intelligence diagnostics unavailable',e)}};
