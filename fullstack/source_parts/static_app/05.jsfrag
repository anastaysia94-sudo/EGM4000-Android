function adminFeatureCard(f){let cls=f.implementation_status==='implemented'?'good':(f.implementation_status==='provider_configuration_required'?'warn':'muted');return `<div class="event"><div class="topline"><b>${esc(f.id)} · ${esc(f.title)}</b><span class="pill ${cls}">${esc(f.implementation_status.replaceAll('_',' '))}</span></div><p class="muted">${esc(f.category)}</p><p>${esc(f.evidence)}</p></div>`}
function adminUserDetail(x){let u=x.user;return `<div class="feed-item"><div class="topline"><h3>${esc(u.display_name)} · @${esc(u.username)}</h3><span class="pill">${u.is_synthetic?'synthetic':'real account'}</span></div><p>${esc(u.email)} · ${esc(u.status)} · ${esc(u.role)}</p><p class="muted">${esc(u.favorite_platform||'No platform')} · ${esc(u.skill_focus||'No focus')}</p><div class="actions">${Object.entries(x.counts).map(([k,v])=>`<span class="pill">${esc(k.replaceAll('_',' '))}: ${v}</span>`).join('')}</div><h4>Recent gameplay</h4>${x.gameplay_sessions.length?x.gameplay_sessions.map(s=>`<p class="muted">#${s.id} ${esc(s.platform)} · ${esc(s.started_at)} · shots ${esc(s.shots??'—')} · hits ${esc(s.hits??'—')}</p>`).join(''):'<p class="muted">No historical sessions.</p>'}<h4>Recent live evidence</h4>${x.live_sessions.length?x.live_sessions.map(s=>`<p class="muted">#${s.id} ${esc(s.platform)} · ${esc(s.status)} · ${esc(s.source)}</p>`).join(''):'<p class="muted">No live sessions.</p>'}<h4>Coaching comparisons</h4>${x.experiments.length?x.experiments.map(expCard).join(''):'<p class="muted">No C014 comparison yet.</p>'}</div>`}
async function admin(){if(!S.me||S.me.role!=='owner'){S.view='today';return today()}let [d,sv,reg,users,reports]=await Promise.all([api('/api/admin/dashboard'),api('/api/admin/surveys'),api('/api/admin/features'),api('/api/admin/users?limit=20'),api('/api/admin/reports?status=open&limit=30')]);let impl=reg.summary.implemented||0,model=reg.summary.modelled||0,provider=reg.summary.provider_configuration_required||0;shell(`<div class="hero"><div class="tag">Owner Command Center · C007</div><h1>Moderate. Measure. Publish. Audit.</h1><p>Admin 100 is explicit and evidence-linked. A capability is only marked implemented when a concrete route, datastore, UI, or safety control backs the claim.</p></div><div class="grid"><div class="card metric span4"><span class="tag">Admin 100 implemented</span><b>${impl}</b><span class="muted">verified capabilities</span></div><div class="card metric span4"><span class="tag">Modelled</span><b>${model}</b><span class="muted">not yet end-to-end</span></div><div class="card metric span4"><span class="tag">Provider configuration</span><b>${provider}</b><span class="muted">provider work still required</span></div><div class="card span6"><h2>User intelligence</h2><div class="actions"><input id="adminUserQ" placeholder="Search name, username, email"><select id="adminUserSynthetic"><option value="">All accounts</option><option value="0">Real only</option><option value="1">Synthetic only</option></select><button id="adminUserSearch" class="aqua">Search</button></div><div id="adminUsers">${users.users.map(u=>`<div class="event"><b>${esc(u.display_name)}</b> <span class="pill">${u.is_synthetic?'synthetic':'real'}</span><p class="muted">@${esc(u.username)} · ${esc(u.status)} · ${esc(u.favorite_platform||'')}</p><button class="userDrill" data-id="${u.id}">Drill down</button></div>`).join('')}</div><div id="adminUserDetail"></div></div><div class="card span6"><h2>Moderation queue</h2><div class="actions"><select id="reportStatus"><option value="open">Open</option><option value="resolved">Resolved</option><option value="all">All</option></select><select id="reportType"><option value="">All types</option><option value="forum_thread">Threads</option><option value="forum_reply">Replies</option><option value="blog_post">Blog posts</option><option value="blog_comment">Comments</option></select><button id="reportFilter">Filter</button></div><div id="adminReports">${reports.reports.length?reports.reports.map(r=>`<div class="event"><b>${esc(r.target_type)} #${r.target_id}</b><p>${esc(r.reason)}</p><p class="muted">${esc(r.status)}</p>${r.status==='open'?`<button class="aqua resolve" data-id="${r.id}">Resolve</button>`:''}</div>`).join(''):'<p class="muted">Queue clear.</p>'}</div></div><div class="card span6"><h2>Survey builder</h2><input id="stitle" placeholder="Survey title"><textarea id="sdesc" placeholder="Description"></textarea><select id="saud"><option value="all">All visitors</option><option value="first">First visitors</option><option value="returning">Returning visitors</option><option value="registered">Registered users</option></select><textarea id="sqs" placeholder="One question per line"></textarea><button class="aqua" id="screate">Create active survey</button><h3>Existing</h3>${sv.map(s=>`<span class="pill">#${s.id} ${esc(s.title)} · ${esc(s.audience)}</span>`).join('')}</div><div class="card span6"><h2>System totals</h2>${Object.entries(d.counts).map(([k,v])=>`<p><span class="pill">${esc(k.replaceAll('_',' '))}</span> <b>${v}</b></p>`).join('')}</div><div class="card span12"><div class="topline"><div><h2>Admin 100 implementation ledger</h2><p class="muted">${reg.total} named capabilities across ${Object.keys(reg.categories).length} categories. Planned entries are deliberately not presented as finished.</p></div><span class="pill">C007 audit</span></div>${reg.features.map(adminFeatureCard).join('')}</div></div>`);
function bindResolve(){document.querySelectorAll('.resolve').forEach(b=>b.onclick=async()=>{let resolution=prompt('Resolution note','Reviewed by owner');if(resolution!==null){await post('/api/admin/resolve-report',{report_id:+b.dataset.id,resolution});admin()}})}
function bindDrill(){document.querySelectorAll('.userDrill').forEach(b=>b.onclick=async()=>{let x=await api('/api/admin/user?id='+b.dataset.id);document.querySelector('#adminUserDetail').innerHTML=adminUserDetail(x)})}
bindResolve();bindDrill();document.querySelector('#adminUserSearch').onclick=async()=>{let q=encodeURIComponent(document.querySelector('#adminUserQ').value),syn=document.querySelector('#adminUserSynthetic').value,x=await api('/api/admin/users?q='+q+'&synthetic='+syn+'&limit=50');document.querySelector('#adminUsers').innerHTML=x.users.map(u=>`<div class="event"><b>${esc(u.display_name)}</b> <span class="pill">${u.is_synthetic?'synthetic':'real'}</span><p class="muted">@${esc(u.username)} · ${esc(u.status)}</p><button class="userDrill" data-id="${u.id}">Drill down</button></div>`).join('')||'<p class="muted">No matching users.</p>';bindDrill()};document.querySelector('#reportFilter').onclick=async()=>{let st=document.querySelector('#reportStatus').value,tt=document.querySelector('#reportType').value,x=await api('/api/admin/reports?status='+encodeURIComponent(st)+'&target_type='+encodeURIComponent(tt)+'&limit=100');document.querySelector('#adminReports').innerHTML=x.reports.map(r=>`<div class="event"><b>${esc(r.target_type)} #${r.target_id}</b><p>${esc(r.reason)}</p><p class="muted">${esc(r.status)}</p>${r.status==='open'?`<button class="aqua resolve" data-id="${r.id}">Resolve</button>`:''}</div>`).join('')||'<p class="muted">No reports match these filters.</p>';bindResolve()};document.querySelector('#screate').onclick=async()=>{let questions=document.querySelector('#sqs').value.split('\n').map(x=>x.trim()).filter(Boolean).map((prompt,i)=>({prompt,kind:i===0?'scale':'text',required:true}));await post('/api/admin/survey',{title:document.querySelector('#stitle').value,description:document.querySelector('#sdesc').value,audience:document.querySelector('#saud').value,frequency_days:30,questions});admin()}}
boot().catch(e=>{A.innerHTML=`<div class="login-wrap"><div class="card"><h2>EGM4000 could not start</h2><p class="warn">${esc(e.message)}</p></div></div>`});
