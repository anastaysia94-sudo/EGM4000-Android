function adminFeatureCard(f){let cls=f.implementation_status==='implemented'?'good':(f.implementation_status==='provider_configuration_required'?'warn':'muted');return `<div class="event"><div class="topline"><b>${esc(f.id)} · ${esc(f.title)}</b><span class="pill ${cls}">${esc(f.implementation_status.replaceAll('_',' '))}</span></div><p class="muted">${esc(f.category)}</p><p>${esc(f.evidence)}</p></div>`}
async function admin(){if(!S.me||S.me.role!=='owner'){S.view='today';return today()}let [d,sv,reg]=await Promise.all([api('/api/admin/dashboard'),api('/api/admin/surveys'),api('/api/admin/features')]);let impl=reg.summary.implemented||0,model=reg.summary.modelled||0,provider=reg.summary.provider_configuration_required||0;shell(`<div class="hero"><div class="tag">Owner Command Center · C007</div><h1>Moderate. Measure. Publish. Audit.</h1><p>Admin 100 is now explicit and evidence-linked. A capability is only marked implemented when the current product has a concrete route, datastore, UI, or safety control backing that claim.</p></div><div class="grid"><div class="card metric span4"><span class="tag">Admin 100 implemented</span><b>${impl}</b><span class="muted">verified capabilities</span></div><div class="card metric span4"><span class="tag">Modelled</span><b>${model}</b><span class="muted">not yet end-to-end</span></div><div class="card metric span4"><span class="tag">Provider configuration</span><b>${provider}</b><span class="muted">monetization/provider work still required</span></div>${Object.entries(d.counts).map(([k,v])=>`<div class="card metric span4"><span class="tag">${esc(k.replaceAll('_',' '))}</span><b>${v}</b></div>`).join('')}<div class="card span6"><h2>Moderation queue</h2>${d.reports.length?d.reports.map(r=>`<div class="event"><b>${esc(r.target_type)} #${r.target_id}</b><p>${esc(r.reason)}</p><p class="muted">${esc(r.status)}</p>${r.status==='open'?`<button class="aqua resolve" data-id="${r.id}">Resolve</button>`:''}</div>`).join(''):'<p class="muted">Queue clear.</p>'}</div><div class="card span6"><h2>Survey builder</h2><input id="stitle" placeholder="Survey title"><textarea id="sdesc" placeholder="Description"></textarea><select id="saud"><option value="all">All visitors</option><option value="first">First visitors</option><option value="returning">Returning visitors</option><option value="registered">Registered users</option></select><textarea id="sqs" placeholder="One question per line"></textarea><button class="aqua" id="screate">Create active survey</button><h3 style="margin-top:18px">Existing</h3>${sv.map(s=>`<span class="pill">#${s.id} ${esc(s.title)} · ${esc(s.audience)}</span>`).join('')}</div><div class="card span12"><div class="topline"><div><h2>Admin 100 implementation ledger</h2><p class="muted">${reg.total} named capabilities across ${Object.keys(reg.categories).length} categories. Planned entries are deliberately not presented as finished.</p></div><span class="pill">C007 audit</span></div>${reg.features.map(adminFeatureCard).join('')}</div></div>`);document.querySelectorAll('.resolve').forEach(b=>b.onclick=async()=>{let resolution=prompt('Resolution note','Reviewed by owner');if(resolution!==null){await post('/api/admin/resolve-report',{report_id:+b.dataset.id,resolution});admin()}});screate.onclick=async()=>{let questions=sqs.value.split('\n').map(x=>x.trim()).filter(Boolean).map((prompt,i)=>({prompt,kind:i===0?'scale':'text',required:true}));await post('/api/admin/survey',{title:stitle.value,description:sdesc.value,audience:saud.value,frequency_days:30,questions});admin()}}
boot().catch(e=>{A.innerHTML=`<div class="login-wrap"><div class="card"><h2>EGM4000 could not start</h2><p class="warn">${esc(e.message)}</p></div></div>`});
