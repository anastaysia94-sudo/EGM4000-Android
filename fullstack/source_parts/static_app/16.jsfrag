// C008 A071/A073/A074/A075/A078/A085/A089 commercial suite UI.
const _c008SuiteTodayBase=today;
today=async function(){
  await _c008SuiteTodayBase();
  try{
    const catalog=await api('/api/commercial/plans');
    const grid=document.querySelector('.content .grid');if(!grid)return;
    let status={subscriptions:[],features:{},requests:[]};
    if(S.me){try{status=await api('/api/commercial/status')}catch(e){}}
    const planCards=catalog.plans.length?catalog.plans.map(p=>{
      const active=status.subscriptions.some(s=>s.planId===p.id);
      const pending=status.requests.some(r=>r.planId===p.id&&r.status==='pending');
      return `<div class="event"><div class="topline"><b>${esc(p.title)}</b><span class="pill">${esc(p.priceLabel||'Access plan')}</span></div><p>${esc(p.description||'')}</p><p class="muted">Features: ${esc((p.features||[]).join(', ')||'base plan')} · seats ${esc(p.seatLimit)}</p>${active?'<span class="pill good">active access</span>':pending?'<span class="pill">request pending</span>':`<textarea class="c008-plan-note" data-plan="${esc(p.id)}" placeholder="Optional note"></textarea><button class="c008-plan-request aqua" data-plan="${esc(p.id)}">${S.me?'Request access':'Sign in to request'}</button>`}</div>`
    }).join(''):'<p class="muted">No active plans are published yet.</p>';
    const featureRows=Object.entries(status.features||{}).map(([k,v])=>`<span class="pill ${v?'good':''}">${esc(k.replaceAll('_',' '))}: ${v?'on':'off'}</span>`).join(' ');
    grid.insertAdjacentHTML('beforeend',`<div class="card span12" id="c008CommercialHub"><div class="tag">C008 · Commercial Access Suite</div><h2>Plans, premium tools & workspaces</h2><p class="muted">${esc(catalog.billingBoundary)}</p><div class="grid"><div class="card span7"><h3>Available plans</h3>${planCards}</div><div class="card span5"><h3>Your access</h3>${S.me?(featureRows||'<p class="muted">No premium feature grants yet.</p>'):'<p class="muted">Sign in to see access status.</p>'}</div></div><div id="c008PremiumTools"></div></div>`);
    document.querySelectorAll('.c008-plan-request').forEach(btn=>btn.onclick=async()=>{if(!S.me)return authScreen();const id=btn.dataset.plan,note=document.querySelector(`.c008-plan-note[data-plan="${CSS.escape(id)}"]`).value;try{await post('/api/commercial/plan-request',{plan_id:id,note});await today()}catch(e){alert(e.message)}});
    if(!S.me)return;
    const tools=document.querySelector('#c008PremiumTools');let html='<div class="grid">';
    if(status.features.advanced_analytics){try{const a=await api('/api/commercial/advanced-analytics');html+=`<div class="card span6"><div class="tag">A073 · Advanced Analytics</div><h3>Your recorded evidence summary</h3><p><b>${esc(a.sessions)}</b> sessions · <b>${esc(a.shots)}</b> shots · observed hit rate <b>${a.observedHitRate==null?'n/a':esc((a.observedHitRate*100).toFixed(1)+'%')}</b></p><p>Recorded spend ${esc(a.recordedSpend)} · payout ${esc(a.recordedPayout)} · net ${esc(a.recordedNet)}</p><p class="muted">${esc(a.boundary)}</p></div>`}catch(e){}}
    if(status.features.research_lab){let r={notes:[]};try{r=await api('/api/commercial/research')}catch(e){};html+=`<div class="card span6"><div class="tag">A075 · Research Lab</div><h3>Private research notebook</h3><input id="c008ResearchTitle" placeholder="Research note title"><select id="c008ResearchLabel"><option>hypothesis</option><option>observed_evidence</option><option>correlation</option><option>estimate</option><option>unknown</option></select><textarea id="c008ResearchBody" placeholder="Evidence, question, uncertainty…"></textarea><button id="c008ResearchSave" class="aqua">Save research note</button><p class="muted">${esc(r.boundary||'Private evidence-labelled notes.')}</p>${r.notes.slice(0,5).map(n=>`<div class="event"><b>${esc(n.title)}</b><span class="pill">${esc(n.evidence_label)}</span><p>${esc(n.body||'')}</p></div>`).join('')}</div>`}
    if(status.features.premium_community){let c={posts:[]};try{c=await api('/api/commercial/premium-community')}catch(e){};html+=`<div class="card span6"><div class="tag">A078 · Premium Community</div><h3>Member room</h3><input id="c008PremiumTitle" placeholder="Post title"><textarea id="c008PremiumBody" placeholder="Evidence-first discussion"></textarea><button id="c008PremiumPost" class="aqua">Post to member room</button><p class="muted">${esc(c.boundary||'Membership changes access only.')}</p>${c.posts.slice(0,6).map(p=>`<div class="event"><b>${esc(p.title)}</b><span class="pill">${esc(p.display_name||'Member')}</span><p>${esc(p.body)}</p></div>`).join('')}</div>`}
    if(status.features.team_workspace||status.features.enterprise_workspace){let w={workspaces:[]};try{w=await api('/api/commercial/workspaces')}catch(e){};html+=`<div class="card span6"><div class="tag">A074 / A085 · Workspaces</div><h3>Coach, team & enterprise workspaces</h3><input id="c008WsName" placeholder="Workspace name"><select id="c008WsKind">${status.features.team_workspace?'<option value="team">team / coach</option>':''}${status.features.enterprise_workspace?'<option value="enterprise">enterprise</option>':''}</select><button id="c008WsCreate" class="aqua">Create workspace</button><p class="muted">${esc(w.boundary||'Workspace access does not automatically expose private evidence.')}</p>${w.workspaces.map(x=>`<div class="event"><div class="topline"><b>${esc(x.name)}</b><span class="pill">${esc(x.kind)} · ${esc(x.members.length)}/${esc(x.seat_limit)} seats</span></div>${x.owner_user_id===S.me.id?`<input class="c008-member-id" data-ws="${esc(x.id)}" inputmode="numeric" placeholder="Existing user ID"><select class="c008-member-role" data-ws="${esc(x.id)}"><option>member</option><option>coach</option></select><button class="c008-member-add" data-ws="${esc(x.id)}">Add member</button>`:''}${x.members.map(m=>`<p class="muted">${esc(m.display_name)} · ${esc(m.role)}</p>`).join('')}</div>`).join('')}</div>`}
    html+='</div>';tools.innerHTML=html;
    const rs=document.querySelector('#c008ResearchSave');if(rs)rs.onclick=async()=>{try{await post('/api/commercial/research-note',{title:document.querySelector('#c008ResearchTitle').value,body:document.querySelector('#c008ResearchBody').value,evidence_label:document.querySelector('#c008ResearchLabel').value});await today()}catch(e){alert(e.message)}};
    const pp=document.querySelector('#c008PremiumPost');if(pp)pp.onclick=async()=>{try{await post('/api/commercial/premium-post',{title:document.querySelector('#c008PremiumTitle').value,body:document.querySelector('#c008PremiumBody').value});await today()}catch(e){alert(e.message)}};
    const wc=document.querySelector('#c008WsCreate');if(wc)wc.onclick=async()=>{try{await post('/api/commercial/workspace',{name:document.querySelector('#c008WsName').value,kind:document.querySelector('#c008WsKind').value});await today()}catch(e){alert(e.message)}};
    document.querySelectorAll('.c008-member-add').forEach(btn=>btn.onclick=async()=>{const ws=btn.dataset.ws;try{await post('/api/commercial/workspace-member',{workspace_id:ws,user_id:Number(document.querySelector(`.c008-member-id[data-ws="${CSS.escape(ws)}"]`).value),role:document.querySelector(`.c008-member-role[data-ws="${CSS.escape(ws)}"]`).value});await today()}catch(e){alert(e.message)}});
  }catch(e){console.warn('commercial suite unavailable',e)}
};

const _c008SuiteAdminBase=admin;
admin=async function(){
  await _c008SuiteAdminBase();
  if(!S.me||S.me.role!=='owner')return;
  try{
    const snap=await api('/api/admin/commercial-suite');const grid=document.querySelector('.content .grid');if(!grid)return;
    let founder=null;try{founder=await api('/api/commercial/founder-analytics')}catch(e){}
    const plans=snap.plans.map(p=>`<div class="event c008-plan-row" data-json="${esc(encodeURIComponent(JSON.stringify(p)))}"><div class="topline"><b>${esc(p.title)}</b><span class="pill">${esc(p.status)}</span></div><p class="muted">${esc((p.features||[]).join(', '))} · ${esc(p.seatLimit)} seats</p><button class="c008-plan-edit">Edit</button></div>`).join('')||'<p class="muted">No plans yet.</p>';
    const reqs=snap.requests.map(r=>`<div class="event"><b>${esc(r.display_name)} → ${esc(r.plan_title)}</b><span class="pill">${esc(r.status)}</span><p>${esc(r.note||'')}</p>${r.status==='pending'?`<button class="c008-grant-request aqua" data-user="${esc(r.user_id)}" data-plan="${esc(r.plan_id)}">Grant external-unverified access</button> <button class="c008-decline-request" data-id="${esc(r.id)}">Decline</button>`:''}</div>`).join('')||'<p class="muted">No plan requests.</p>';
    const subs=snap.subscriptions.slice(0,30).map(s=>`<div class="event"><b>${esc(s.display_name)} · ${esc(s.plan_title)}</b><span class="pill ${s.status==='active'?'good':''}">${esc(s.status)}</span><p class="muted">source: ${esc(s.source)}</p>${s.status==='active'?`<button class="c008-sub-revoke" data-id="${esc(s.id)}">Revoke</button>`:''}</div>`).join('');
    grid.insertAdjacentHTML('beforeend',`<div class="card span12" id="c008SuiteAdmin"><div class="tag">C008 · A071/A073/A074/A075/A078/A085/A089</div><h2>Commercial plans & entitlement control</h2><p class="muted">${esc(snap.boundary)}</p><div class="grid"><div class="card span5"><input id="c008PlanId" type="hidden"><label>Plan title</label><input id="c008PlanTitle"><label>Description</label><textarea id="c008PlanDescription"></textarea><label>Price label</label><input id="c008PlanPrice" placeholder="$19/mo, Quote required…"><label>Features, comma separated</label><textarea id="c008PlanFeatures" placeholder="advanced_analytics, research_lab, team_workspace"></textarea><label>Seat limit</label><input id="c008PlanSeats" type="number" min="1" max="500" value="1"><label>Status</label><select id="c008PlanStatus"><option>draft</option><option>active</option><option>archived</option></select><button id="c008PlanSave" class="aqua">Save plan</button><h3>Plans</h3>${plans}</div><div class="card span7"><h3>Requests</h3>${reqs}<h3>Access grants</h3>${subs}<hr><h3>Manual grant</h3><input id="c008GrantUser" inputmode="numeric" placeholder="User ID"><input id="c008GrantPlan" placeholder="Plan ID"><select id="c008GrantSource"><option>complimentary</option><option>external_unverified</option></select><textarea id="c008GrantNote" placeholder="Provisioning note"></textarea><button id="c008GrantSave" class="aqua">Grant access</button></div></div>${founder?`<div class="card"><div class="tag">A089 · Founder Analytics</div><p><b>${esc(founder.totals.activeSubscriptions)}</b> active access grants · <b>${esc(founder.totals.workspaces)}</b> workspaces · <b>${esc(founder.totals.researchNotes)}</b> research notes · <b>${esc(founder.totals.premiumPosts)}</b> premium posts</p><p class="muted">${esc(founder.boundary)}</p></div>`:'<p class="muted">A089 founder analytics is entitlement-gated. Grant the owner a plan containing founder_analytics to activate it.</p>'}</div>`);
    const fill=p=>{document.querySelector('#c008PlanId').value=p.id||'';document.querySelector('#c008PlanTitle').value=p.title||'';document.querySelector('#c008PlanDescription').value=p.description||'';document.querySelector('#c008PlanPrice').value=p.priceLabel||'';document.querySelector('#c008PlanFeatures').value=(p.features||[]).join(', ');document.querySelector('#c008PlanSeats').value=p.seatLimit||1;document.querySelector('#c008PlanStatus').value=p.status||'draft'};
    document.querySelectorAll('.c008-plan-edit').forEach(btn=>btn.onclick=()=>{fill(JSON.parse(decodeURIComponent(btn.closest('.c008-plan-row').dataset.json)));document.querySelector('#c008SuiteAdmin').scrollIntoView({behavior:'smooth'})});
    document.querySelector('#c008PlanSave').onclick=async()=>{try{await post('/api/admin/commercial-plan',{id:document.querySelector('#c008PlanId').value||undefined,title:document.querySelector('#c008PlanTitle').value,description:document.querySelector('#c008PlanDescription').value,price_label:document.querySelector('#c008PlanPrice').value,features:document.querySelector('#c008PlanFeatures').value,seat_limit:Number(document.querySelector('#c008PlanSeats').value||1),status:document.querySelector('#c008PlanStatus').value});await admin()}catch(e){alert(e.message)}};
    const grant=async(user,plan,source='external_unverified',note='Owner provisioned access')=>{await post('/api/admin/commercial-subscription',{action:'grant',user_id:Number(user),plan_id:plan,source,note})};
    document.querySelectorAll('.c008-grant-request').forEach(btn=>btn.onclick=async()=>{try{await grant(btn.dataset.user,btn.dataset.plan);await admin()}catch(e){alert(e.message)}});
    document.querySelectorAll('.c008-decline-request').forEach(btn=>btn.onclick=async()=>{try{await post('/api/admin/commercial-plan-request',{id:btn.dataset.id,status:'declined'});await admin()}catch(e){alert(e.message)}});
    document.querySelectorAll('.c008-sub-revoke').forEach(btn=>btn.onclick=async()=>{try{await post('/api/admin/commercial-subscription',{action:'revoke',subscription_id:btn.dataset.id});await admin()}catch(e){alert(e.message)}});
    document.querySelector('#c008GrantSave').onclick=async()=>{try{await grant(document.querySelector('#c008GrantUser').value,document.querySelector('#c008GrantPlan').value,document.querySelector('#c008GrantSource').value,document.querySelector('#c008GrantNote').value);await admin()}catch(e){alert(e.message)}};
  }catch(e){console.warn('commercial suite admin unavailable',e)}
};