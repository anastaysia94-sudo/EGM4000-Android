function tipEvidence(t){try{return JSON.parse(t.evidence||'{}')}catch{return null}}
async function tips(){if(!S.me)return authScreen();let rows=await api('/api/tips');shell(`<div class="hero"><div class="tag">C006 · Session-derived Tips Center</div><h1>Coaching with receipts, confidence, and uncertainty.</h1><p>Live and imported evidence produces persistent guidance. Every generated tip shows what was measured, the sample size, evidence class, and what EGM4000 still cannot know.</p></div><div class="grid"><div class="card span12">${rows.length?rows.map(t=>{let e=tipEvidence(t),q=e?.quality,m=e?.metrics,c=e?.coaching;return `<div class="feed-item"><div class="topline"><h3>${esc(t.title)}</h3><span class="pill">${esc(t.confidence)} confidence</span></div><p>${esc(t.body)}</p><div class="actions"><span class="pill">${esc(t.evidence_type||q?.evidenceType||'observed_evidence')}</span><span class="pill">sample ${esc(t.sample_size||q?.sampleSize||'n/a')}</span>${q?.confidence!=null?`<span class="pill">analysis ${Math.round(q.confidence*100)}%</span>`:''}</div>${m?`<p class="muted"><b>${esc(t.platform||'Session')}</b> · events ${esc(m.events)} · shots ${esc(m.shots)} · net credit movement ${esc(m.credit_delta)} · breaks ${esc(m.breaks??0)}</p>`:`<p class="muted"><b>${esc(t.platform||'Session')}</b> · ${esc(t.evidence)}</p>`}<details><summary>Evidence + uncertainty</summary><p class="muted">${esc(t.uncertainty||'This is evidence review, not a prediction of future random results.')}</p>${e?.pattern?`<p><b>Detected pattern:</b> ${esc(e.pattern.title)} · ${Math.round((e.pattern.confidence||0)*100)}% confidence</p>`:''}<p class="muted">${t.live_session_id?`Live session #${esc(t.live_session_id)}`:`Historical session #${esc(t.session_id)}`} · ${esc(t.started_at||t.created_at)}</p></details></div>`}).join(''):'<p class="muted">No tips yet. Start a session and record consistent evidence first.</p>'}</div></div>`) }
function analysisHtml(a){if(!a)return '';let q=a.quality||{},m=a.metrics||{};return `<div class="event"><div class="topline"><b>Core-loop analysis</b><span class="pill">${Math.round((q.confidence||0)*100)}% confidence</span></div><p class="muted">sample ${q.sampleSize||0} · ${esc(q.evidenceType||'unknown')} · completeness ${Math.round((q.completeness||0)*100)}%</p><p>Events ${m.events||0} · shots ${m.shots||0} · pace ${m.shots_per_min||0}/min · net credit movement ${m.credit_delta||0} · drawdown ${m.max_drawdown||0} · breaks ${m.breaks||0}</p>${(a.patterns||[]).map(p=>`<p><b>${esc(p.title)}</b><br>${esc(p.body)}</p>`).join('')}${(a.coaching||[]).map(c=>`<div class="feed-item"><b>${esc(c.title)}</b><p>${esc(c.action)}</p><span class="pill">target: ${esc(c.targetMetric)}</span></div>`).join('')}<p class="muted">${esc(a.uncertainty||'')}</p></div>`}
async function live(){if(!S.me)return authScreen();let ads=await api('/api/adapters');shell(`<div class="hero"><div class="tag">Live Core Loop</div><h1>Record → analyze → explain → improve.</h1><p>Manual controls are user-verified observations. F.S.A. exact telemetry remains a separate owned-game integration path and cannot be faked by manual buttons.</p></div><div class="grid"><div class="card span8"><select id="platform">${ads.map(x=>`<option value="${esc(x.id)}">${esc(x.name)} · ${esc(x.mode)}</option>`).join('')}</select><div class="actions"><button class="aqua" id="start">Start authorized session</button><button data-e="shot_fired">Verified shot</button><button data-e="target_hit">Verified hit</button><button data-e="target_destroyed">Verified destroy</button><button data-credit="10">Credit +10</button><button data-credit="-10">Credit -10</button><button data-e="break">Break</button><button id="motion">Motion estimate</button><button id="analyze">Analyze now</button><button id="replay">Replay</button></div><div id="livebox"></div></div><div class="card span4"><h2>Evidence boundary</h2><p><span class="pill">observed_evidence</span> Manual/user verified.</p><p><span class="pill">estimate</span> Visible signal inferred by EGM.</p><p><span class="pill">correlation</span> Descriptive relationship only.</p><p><span class="pill">exact_telemetry</span> Only authenticated owned F.S.A. telemetry.</p><p class="muted">Selecting F.S.A. here does not turn manual clicks into exact telemetry.</p></div></div>`);platform.onchange=()=>{S.platform=platform.value;livebox.innerHTML=S.platform==='fsa'?'<div class="event"><b>F.S.A. selected.</b><p class="muted">Manual event buttons are disabled for this adapter. Use the owned F.S.A. telemetry contract/bridge for exact events.</p></div>':''};S.platform=platform.value;start.onclick=async()=>{let x=await post('/api/live/start',{platform:S.platform});S.sid=x.session_id;livebox.innerHTML=`<p class="pill">session ${S.sid}</p>${S.platform==='fsa'?'<p class="muted">Waiting for owned F.S.A. exact telemetry.</p>':''}`};document.querySelectorAll('[data-e]').forEach(b=>b.onclick=()=>emitManual(b.dataset.e,{}));document.querySelectorAll('[data-credit]').forEach(b=>b.onclick=()=>emitManual('credit_change',{creditDelta:Number(b.dataset.credit)}));motion.onclick=()=>emitManual('motion_sample',{motion:Math.random()*.2},'estimate',.65);analyze.onclick=async()=>{if(!S.sid)return alert('Start a session first.');let a=await api('/api/live/analysis?session_id='+S.sid);livebox.innerHTML=analysisHtml(a)+livebox.innerHTML};replay.onclick=async()=>{let rows=await api('/api/live/replay');livebox.innerHTML=rows.slice(0,100).map(x=>`<div class="event"><b>${esc(x.event_type)}</b> <span class="pill">${esc(x.evidence_type)}</span> ${Math.round(x.confidence*100)}%<br><span class="muted">${esc(x.platform)} · ${esc(x.event_time)}</span></div>`).join('')}}
async function emitManual(type,payload={},evidence_type='observed_evidence',confidence=1){if(!S.sid)return alert('Start a session first.');if(S.platform==='fsa')return alert('F.S.A. exact telemetry must come from the owned F.S.A. integration bridge; manual clicks are not exact telemetry.');let x=await post('/api/live/event',{session_id:S.sid,platform:S.platform,type,evidence_type,confidence,payload});let a=await api('/api/live/analysis?session_id='+S.sid);livebox.innerHTML=analysisHtml(a)+`<div class="event"><b>${esc(type)}</b> · ${esc(evidence_type)}<br><span class="muted">events ${x.metrics.events} · shots ${x.metrics.shots} · hits ${x.metrics.hits} · kills ${x.metrics.kills}</span></div>`}
