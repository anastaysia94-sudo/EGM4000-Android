            if tt not in allowed or action not in ('hide','restore','publish','remove'):return self.json({'error':'invalid_moderation_action'},400)
            status='published' if action in ('restore','publish') else 'hidden';con=db();con.execute(f'UPDATE {allowed[tt]} SET status=? WHERE id=?',(status,tid));audit(con,s['id'],'moderation_'+action,tt,tid);con.commit();con.close();return self.json({'ok':True,'status':status})
