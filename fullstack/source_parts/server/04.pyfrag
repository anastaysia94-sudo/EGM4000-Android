            if not pid or len(body)<2:return self.json({'error':'invalid_comment'},400)
            con=db();cid=insert_id(con,'INSERT INTO blog_comments(post_id,user_id,body,status,created_at) VALUES(?,?,?,?,?)',(pid,s['id'],body,'published',now()));audit(con,s['id'],'blog_comment_created','blog_comment',cid);con.commit();con.close();return self.json({'ok':True,'id':cid},201)
        if path=='/api/report':
            s=self.need(csrf=True);
            if not s:return
