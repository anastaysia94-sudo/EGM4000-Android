            tid=int(b.get('thread_id',0));body=clean(b.get('body'),5000)
            if not tid or len(body)<2:return self.json({'error':'invalid_reply'},400)
            con=db();rid=insert_id(con,'INSERT INTO forum_replies(thread_id,user_id,body,status,created_at) VALUES(?,?,?,?,?)',(tid,s['id'],body,'published',now()));audit(con,s['id'],'forum_reply_created','forum_reply',rid);con.commit();con.close();return self.json({'ok':True,'id':rid},201)
        if path=='/api/blog/post':
            s=self.need(csrf=True);
