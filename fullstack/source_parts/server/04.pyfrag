        if path=='/api/survey/respond':
            if not rate(WRITE_BUCKET,'survey:'+ip,30,3600):return self.json({'error':'rate_limited'},429)
            v=self.visitor(touch=False);s=self.session();sid=int(b.get('survey_id',0));answers=b.get('answers') if isinstance(b.get('answers'),dict) else {}
            if not v['consent']:return self.json({'error':'survey_consent_required'},403,cookies=[v['cookie']] if v['cookie'] else None)
            con=db();survey=rowdict(con.execute("SELECT * FROM surveys WHERE id=? AND status='active'",(sid,)).fetchone())
            if not survey:con.close();return self.json({'error':'survey_not_found'},404)
            rid=insert_id(con,'INSERT INTO survey_responses(survey_id,user_id,visitor_hash,created_at) VALUES(?,?,?,?)',(sid,s['id'] if s else None,v['hash'],now()));
            qs=con.execute('SELECT id FROM survey_questions WHERE survey_id=?',(sid,)).fetchall();valid={str(rowdict(x)['id']) for x in qs}
            for k,val in answers.items():
                if str(k) in valid:con.execute('INSERT INTO survey_answers(response_id,question_id,answer_text) VALUES(?,?,?)',(rid,int(k),clean(val,2000)))
            con.commit();con.close();return self.json({'ok':True,'response_id':rid},201,cookies=[v['cookie']] if v['cookie'] else None)
        if path=='/api/admin/moderate':
            s=self.need(owner=True,csrf=True);
            if not s:return
