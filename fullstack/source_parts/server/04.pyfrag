            if tt not in ('forum_thread','forum_reply','blog_post','blog_comment') or not tid:return self.json({'error':'invalid_report'},400)
            con=db();rid=insert_id(con,'INSERT INTO reports(reporter_user_id,target_type,target_id,reason,status,resolution,created_at,resolved_at) VALUES(?,?,?,?,?,?,?,?)',(s['id'],tt,tid,reason or 'User report','open','',now(),None));audit(con,s['id'],'content_reported','report',rid);con.commit();con.close();return self.json({'ok':True,'id':rid},201)
        if path=='/api/survey/consent':
