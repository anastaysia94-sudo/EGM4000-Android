            title=clean(b.get('title'),160);body=clean(b.get('body'),12000);tags=clean(b.get('tags'),300);status='published' if s['role']=='owner' else 'pending'
            if len(title)<4 or len(body)<20:return self.json({'error':'content_too_short'},400)
            con=db();pid=insert_id(con,'INSERT INTO blog_posts(user_id,title,body,tags,status,created_at,updated_at) VALUES(?,?,?,?,?,?,?)',(s['id'],title,body,tags,status,now(),now()));audit(con,s['id'],'blog_post_submitted','blog_post',pid,{'status':status});con.commit();con.close();return self.json({'ok':True,'id':pid,'status':status},201)
        if path=='/api/blog/comment':
            s=self.need(csrf=True);
