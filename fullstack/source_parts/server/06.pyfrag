        if not str(fp).startswith(str(STATIC.resolve())) or not fp.exists():fp=STATIC/'index.html'
        data=fp.read_bytes();self.send_response(200);self.send_header('Content-Type',mimetypes.guess_type(str(fp))[0] or 'application/octet-stream');self.send_header('Cache-Control','no-cache' if fp.name in ('index.html','sw.js') else 'public,max-age=3600');self.send_common();self.send_header('Content-Length',str(len(data)));self.end_headers();self.wfile.write(data)

# C007 canonical Admin 100 registry. Sync at runtime so existing databases with
# placeholder capability names converge to the same audited source-of-truth.
from admin_registry import sync_admin_registry,registry_payload
_admin=db()
try:sync_admin_registry(_admin)
finally:_admin.close()
_original_do_GET=App.do_GET
def _admin_registry_do_GET(self):
    parsed=urlparse(self.path);path=parsed.path;q=parse_qs(parsed.query)
    if path=='/api/admin/features':
        s=self.need(owner=True)
        if not s:return
        con=db();rows=rowsdict(con.execute('SELECT * FROM admin_features ORDER BY id').fetchall());out=registry_payload(rows);con.close();return self.json(out)
    if path=='/api/admin/users':
        s=self.need(owner=True)
        if not s:return
        term=clean(qval(q,'q',''),80);status=clean(qval(q,'status',''),20);synthetic=clean(qval(q,'synthetic',''),10);limit=max(1,min(200,int(qval(q,'limit','50') or 50)))
        where=[];args=[]
        if term:
            like='%'+term.lower()+'%';where.append('(LOWER(username) LIKE ? OR LOWER(display_name) LIKE ? OR LOWER(email) LIKE ?)');args.extend([like,like,like])
        if status in ('active','inactive','suspended'):where.append('status=?');args.append(status)
        if synthetic in ('0','1'):where.append('is_synthetic=?');args.append(int(synthetic))
        clause=(' WHERE '+' AND '.join(where)) if where else ''
        con=db();rows=rowsdict(con.execute('SELECT id,username,email,role,display_name,favorite_platform,skill_focus,joined_at,status,is_synthetic FROM users'+clause+' ORDER BY id DESC LIMIT ?',tuple(args+[limit])).fetchall());con.close();return self.json({'count':len(rows),'users':rows})
    if path=='/api/admin/user':
        s=self.need(owner=True)
        if not s:return
        uid=int(qval(q,'id','0') or 0);con=db();u=rowdict(con.execute('SELECT id,username,email,role,display_name,bio,favorite_platform,skill_focus,joined_at,status,is_synthetic FROM users WHERE id=?',(uid,)).fetchone())
        if not u:con.close();return self.json({'error':'user_not_found'},404)
        counts={'gameplay_sessions':scalar(con,'SELECT COUNT(*) FROM gameplay_sessions WHERE user_id=?',(uid,)),'live_sessions':scalar(con,'SELECT COUNT(*) FROM live_sessions WHERE user_id=?',(uid,)),'tips':scalar(con,'SELECT COUNT(*) FROM tips WHERE user_id=?',(uid,)),'threads':scalar(con,'SELECT COUNT(*) FROM forum_threads WHERE user_id=?',(uid,)),'posts':scalar(con,'SELECT COUNT(*) FROM blog_posts WHERE user_id=?',(uid,)),'experiments':scalar(con,'SELECT COUNT(*) FROM coaching_experiments WHERE user_id=?',(uid,))}
        sessions=rowsdict(con.execute('SELECT id,platform,started_at,duration_min,shots,hits,source FROM gameplay_sessions WHERE user_id=? ORDER BY id DESC LIMIT 12',(uid,)).fetchall());live=rowsdict(con.execute('SELECT id,platform,started_at,ended_at,status,source FROM live_sessions WHERE user_id=? ORDER BY id DESC LIMIT 12',(uid,)).fetchall());tips=rowsdict(con.execute('SELECT id,created_at,title,confidence,evidence_type,sample_size,live_session_id,session_id FROM tips WHERE user_id=? ORDER BY id DESC LIMIT 12',(uid,)).fetchall());experiments=list_experiments(con,uid,12);con.close();return self.json({'user':u,'counts':counts,'gameplay_sessions':sessions,'live_sessions':live,'tips':tips,'experiments':experiments})
    if path=='/api/admin/reports':
        s=self.need(owner=True)
        if not s:return
        status=clean(qval(q,'status','open'),20);target=clean(qval(q,'target_type',''),30);limit=max(1,min(200,int(qval(q,'limit','50') or 50)));where=[];args=[]
        if status in ('open','resolved'):where.append('status=?');args.append(status)
        elif status!='all':where.append('status=?');args.append('open')
        if target in ('forum_thread','forum_reply','blog_post','blog_comment'):where.append('target_type=?');args.append(target)
        clause=(' WHERE '+' AND '.join(where)) if where else ''
        con=db();rows=rowsdict(con.execute('SELECT * FROM reports'+clause+' ORDER BY id DESC LIMIT ?',tuple(args+[limit])).fetchall());con.close();return self.json({'count':len(rows),'reports':rows,'filters':{'status':status,'target_type':target}})
    if path=='/api/admin/survey-analytics':
        s=self.need(owner=True)
        if not s:return
        sid=int(qval(q,'survey_id','0') or 0);con=db();survey=rowdict(con.execute('SELECT * FROM surveys WHERE id=?',(sid,)).fetchone())
        if not survey:con.close();return self.json({'error':'survey_not_found'},404)
        questions=rowsdict(con.execute('SELECT * FROM survey_questions WHERE survey_id=? ORDER BY position,id',(sid,)).fetchall());total=scalar(con,'SELECT COUNT(*) FROM survey_responses WHERE survey_id=?',(sid,));answers=[]
        for question in questions:
            vals=rowsdict(con.execute('SELECT a.answer_text,COUNT(*) count FROM survey_answers a JOIN survey_responses r ON r.id=a.response_id WHERE r.survey_id=? AND a.question_id=? GROUP BY a.answer_text ORDER BY count DESC LIMIT 100',(sid,question['id'])).fetchall());answers.append({'question':question,'answer_counts':vals})
        con.close();return self.json({'survey':survey,'responses':total,'questions':answers})
    if path=='/api/admin/survey-export':
        s=self.need(owner=True)
        if not s:return
        sid=int(qval(q,'survey_id','0') or 0);con=db();survey=rowdict(con.execute('SELECT id,title FROM surveys WHERE id=?',(sid,)).fetchone())
        if not survey:con.close();return self.json({'error':'survey_not_found'},404)
        rows=rowsdict(con.execute('SELECT r.id response_id,r.user_id,r.visitor_hash,r.created_at,q.id question_id,q.prompt,a.answer_text FROM survey_responses r LEFT JOIN survey_answers a ON a.response_id=r.id LEFT JOIN survey_questions q ON q.id=a.question_id WHERE r.survey_id=? ORDER BY r.id,q.position,q.id',(sid,)).fetchall());con.close();return self.json({'survey':survey,'rows':rows,'privacy':'visitor_hash is pseudonymous; raw IP addresses are not exported'})
    return _original_do_GET(self)
App.do_GET=_admin_registry_do_GET

# Admin writes added as audited C007 controls.
_admin_post_base=App.do_POST
def _c007_admin_do_POST(self):
    path=urlparse(self.path).path
    if path in ('/api/admin/pin-thread','/api/admin/survey-lifecycle'):
        b=self.body();s=self.need(owner=True,csrf=True)
        if not s:return
        con=db()
        if path=='/api/admin/pin-thread':
            tid=int(b.get('thread_id',0));pinned=1 if b.get('pinned') else 0
            if not con.execute('SELECT id FROM forum_threads WHERE id=?',(tid,)).fetchone():con.close();return self.json({'error':'thread_not_found'},404)
            con.execute('UPDATE forum_threads SET pinned=?,updated_at=? WHERE id=?',(pinned,now(),tid));audit(con,s['id'],'thread_pinned' if pinned else 'thread_unpinned','forum_thread',tid);con.commit();con.close();return self.json({'ok':True,'thread_id':tid,'pinned':bool(pinned)})
        sid=int(b.get('survey_id',0));status=clean(b.get('status'),20);frequency=max(1,min(3650,int(b.get('frequency_days',30) or 30)));starts=clean(b.get('starts_at'),80) or None;ends=clean(b.get('ends_at'),80) or None
        if status not in ('draft','active','paused','closed'):con.close();return self.json({'error':'invalid_survey_status'},400)
        if not con.execute('SELECT id FROM surveys WHERE id=?',(sid,)).fetchone():con.close();return self.json({'error':'survey_not_found'},404)
        con.execute('UPDATE surveys SET status=?,frequency_days=?,starts_at=?,ends_at=? WHERE id=?',(status,frequency,starts,ends,sid));audit(con,s['id'],'survey_lifecycle_updated','survey',sid,{'status':status,'frequency_days':frequency,'starts_at':starts,'ends_at':ends});con.commit();con.close();return self.json({'ok':True,'survey_id':sid,'status':status,'frequency_days':frequency,'starts_at':starts,'ends_at':ends})
    return _admin_post_base(self)
App.do_POST=_c007_admin_do_POST

# F.S.A. remains a separate owned product. Exact telemetry enters only through this
# token-authenticated bridge; ordinary /api/live/event requests cannot self-label exact data.
import io
_c=db();
try:
    _c.execute('CREATE TABLE IF NOT EXISTS fsa_integration_sessions(source_product TEXT NOT NULL,external_session_id TEXT NOT NULL,user_id INTEGER NOT NULL,live_session_id INTEGER NOT NULL,created_at TEXT NOT NULL,PRIMARY KEY(source_product,external_session_id,user_id))');_c.commit()
finally:_c.close()
_original_do_POST=App.do_POST
def _integrated_do_POST(self):
    path=urlparse(self.path).path
    if path=='/api/fsa/telemetry':
        expected=os.environ.get('EGM_FSA_TELEMETRY_TOKEN','')
        supplied=self.headers.get('X-EGM-FSA-Token','')
        if not expected or not supplied or not hmac.compare_digest(expected,supplied):return self.json({'error':'fsa_bridge_auth_required'},401)
        b=self.body();required=('userId','sessionId','eventId','eventType','occurredAt')
        if any(not b.get(k) for k in required):return self.json({'error':'invalid_fsa_event'},400)
        if b.get('sourceProduct')!='fsa' or b.get('evidenceLabel')!='exact_telemetry' or float(b.get('confidence',0))!=1:return self.json({'error':'invalid_exact_telemetry_claim'},400)
        payload=b.get('payload') if isinstance(b.get('payload'),dict) else {};typ=clean(b.get('eventType'),80)
        if typ=='credit_changed' and payload.get('currencyType')!='virtual_non_cash_credit':return self.json({'error':'fsa_credit_must_be_virtual_non_cash'},400)
        uid=int(b.get('userId'));ext=clean(b.get('sessionId'),160);event_id=clean(b.get('eventId'),200);con=db()
        try:
            if not con.execute('SELECT id FROM users WHERE id=? AND status=?',(uid,'active')).fetchone():con.close();return self.json({'error':'user_not_found'},404)
            link=rowdict(con.execute('SELECT * FROM fsa_integration_sessions WHERE source_product=? AND external_session_id=? AND user_id=?',('fsa',ext,uid)).fetchone())
            if link:sid=int(link['live_session_id'])
            else:
                sid=start_session(con,uid,'fsa','fsa-owned-bridge');con.execute('INSERT INTO fsa_integration_sessions(source_product,external_session_id,user_id,live_session_id,created_at) VALUES(?,?,?,?,?)',('fsa',ext,uid,sid,now()));con.commit()
            eid=append_event(con,user_id=uid,session_id=sid,platform='fsa',event_type=typ,source='fsa-owned-bridge',evidence_type='exact_telemetry',confidence=1,payload=payload,source_event_id=event_id,event_time=clean(b.get('occurredAt'),80));out=analyze_session(con,uid,sid);con.close();return self.json({'ok':True,'event_id':eid,'live_session_id':sid,'analysis':out},201)
        except Exception as e:
            try:con.close()
            except Exception:pass
            return self.json({'error':'duplicate_or_invalid_fsa_event','detail':clean(str(e),240)},409)
    if path=='/api/live/event':
        raw=self.rfile.read(int(self.headers.get('Content-Length','0') or 0));self.rfile=io.BytesIO(raw)
        try:b=json.loads(raw or b'{}')
        except Exception:b={}
        if b.get('evidence_type')=='exact_telemetry':return self.json({'error':'exact_telemetry_requires_fsa_bridge'},403)
    return _original_do_POST(self)
App.do_POST=_integrated_do_POST

if __name__=='__main__':
    print(f'EGM4000 public fullstack: http://{HOST}:{PORT}')
    ThreadingHTTPServer((HOST,PORT),App).serve_forever()
