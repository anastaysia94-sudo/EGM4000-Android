#!/usr/bin/env python3
from __future__ import annotations
from http.server import ThreadingHTTPServer,BaseHTTPRequestHandler
from urllib.parse import urlparse,parse_qs
from pathlib import Path
from datetime import datetime,timedelta,timezone
from http.cookies import SimpleCookie
import base64,hashlib,hmac,json,mimetypes,os,re,secrets,time
from bootstrap_db import bootstrap,hash_password
from storage import connect,rowdict,rowsdict,scalar,insert_id
from live_intelligence import ADAPTERS,append_event,metrics,migrate,start_session,context_pack

ROOT=Path(__file__).resolve().parent; STATIC=ROOT/'static'
HOST=os.environ.get('EGM_HOST','0.0.0.0'); PORT=int(os.environ.get('PORT',os.environ.get('EGM_PORT','8040')))
SECURE=os.environ.get('EGM_SECURE_COOKIES','0')=='1'; VISITOR_SECRET=os.environ.get('EGM_VISITOR_SECRET') or os.environ.get('EGM_OWNER_PASSWORD','dev-visitor-secret')
LOGIN_BUCKET={}; WRITE_BUCKET={}
bootstrap(); c=connect(); migrate(c); c.close()

def now():return datetime.now(timezone.utc).replace(microsecond=0).isoformat()
def db():return connect()
def clean(s,n=4000):return str(s or '').strip()[:n]
def qval(q,k,default=''):
    v=q.get(k);return v[0] if v else default
def verify(password,stored,salt):
    raw=base64.b64decode(salt);d=hashlib.pbkdf2_hmac('sha256',password.encode(),raw,240_000);return hmac.compare_digest(base64.b64encode(d).decode(),stored)
def token_hash(t):return hashlib.sha256(t.encode()).hexdigest()
def audit(con,actor,action,target_type='',target_id='',details=None):
    con.execute('INSERT INTO audit_events(actor_user_id,action,target_type,target_id,details_json,created_at) VALUES(?,?,?,?,?,?)',(actor,action,target_type,str(target_id or ''),json.dumps(details or {}),now()))
def rate(bucket,key,limit,window):
    t=time.time();arr=[x for x in bucket.get(key,[]) if t-x<window]
    if len(arr)>=limit:return False
    arr.append(t);bucket[key]=arr;return True

class App(BaseHTTPRequestHandler):
    server_version='EGM4000/2.0'
    def log_message(self,fmt,*args):print('[EGM4000]',fmt%args)
    def body(self):
        try:return json.loads(self.rfile.read(int(self.headers.get('Content-Length','0') or 0)) or b'{}')
        except:return {}
    def send_common(self):
        self.send_header('X-Content-Type-Options','nosniff');self.send_header('Referrer-Policy','same-origin');self.send_header('Permissions-Policy','camera=(), microphone=(), geolocation=()')
    def json(self,obj,status=200,cookies=None):
        b=json.dumps(obj,default=str).encode();self.send_response(status);self.send_header('Content-Type','application/json');self.send_header('Cache-Control','no-store');self.send_common();self.send_header('Content-Length',str(len(b)))
        for c in cookies or []:self.send_header('Set-Cookie',c)
        self.end_headers();self.wfile.write(b)
    def client_key(self):
        ip=(self.headers.get('X-Forwarded-For') or self.client_address[0] or '').split(',')[0].strip();ua=self.headers.get('User-Agent','')[:220]
        return ip,ua
    def visitor(self,touch=True,consent=None):
        cookie=SimpleCookie();cookie.load(self.headers.get('Cookie',''));item=cookie.get('egm_visitor');raw=item.value if item else secrets.token_urlsafe(24);set_cookie=None
        if not item:set_cookie=f'egm_visitor={raw}; Path=/; Max-Age=31536000; SameSite=Lax'+('; Secure' if SECURE else '')
        ip,ua=self.client_key();vh=hmac.new(VISITOR_SECRET.encode(),raw.encode(),hashlib.sha256).hexdigest();nh=hmac.new(VISITOR_SECRET.encode(),ip.encode(),hashlib.sha256).hexdigest() if ip else ''
        con=db();r=con.execute('SELECT * FROM visitor_profiles WHERE visitor_hash=?',(vh,)).fetchone();s=self.session()
        if not r:
            con.execute('INSERT INTO visitor_profiles(visitor_hash,network_hash,first_seen_at,last_seen_at,visit_count,consent,user_id) VALUES(?,?,?,?,?,?,?)',(vh,nh,now(),now(),1,1 if consent else 0,s['id'] if s else None));visits=1;cons=1 if consent else 0
        else:
            d=rowdict(r);visits=int(d['visit_count'])+(1 if touch else 0);cons=int(d['consent']) if consent is None else (1 if consent else 0);con.execute('UPDATE visitor_profiles SET network_hash=?,last_seen_at=?,visit_count=?,consent=?,user_id=COALESCE(?,user_id) WHERE visitor_hash=?',(nh,now(),visits,cons,s['id'] if s else None,vh))
        con.commit();con.close();return {'hash':vh,'visits':visits,'consent':cons,'cookie':set_cookie}
    def session(self):
        c=SimpleCookie();c.load(self.headers.get('Cookie',''));item=c.get('egm_session')
        if not item:return None
        con=db();r=con.execute('SELECT s.token,s.csrf,s.expires_at,u.* FROM auth_sessions s JOIN users u ON u.id=s.user_id WHERE s.token=?',(item.value,)).fetchone();con.close();d=rowdict(r)
        return d if d and d['expires_at']>now() and d['status']=='active' else None
    def mobile(self):
        h=self.headers.get('Authorization','');
        if not h.startswith('Bearer '):return None
