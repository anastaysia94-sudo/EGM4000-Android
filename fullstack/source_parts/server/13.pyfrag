
# C009 completion: persisted return-user workspace and the remaining R001-R049 behaviors.
from return_workspace import SAFE_GOAL_TYPES,build_return_workspace,load_preferences,migrate_return_workspace,smart_tags

_c009x=db()
try:migrate_return_workspace(_c009x)
finally:_c009x.close()

_RETURN_MEDIA_LIMITS={'screenshot':2_000_000,'video':8_000_000,'voice':4_000_000}
_RETURN_MEDIA_MIME={
    'screenshot':{'image/png':'png','image/jpeg':'jpg','image/webp':'webp'},
    'video':{'video/webm':'webm','video/mp4':'mp4'},
    'voice':{'audio/webm':'webm','audio/ogg':'ogg','audio/mp4':'m4a','audio/mpeg':'mp3'},
}

def _return_record(con,user_id,feature_id,event_name,context=None):
    con.execute(
        'INSERT INTO feature_usage_events(user_id,feature_id,event_name,context_json,created_at) VALUES(?,?,?,?,?)',
        (user_id,feature_id,event_name,json.dumps(context or {},separators=(',',':'))[:2000],now())
    )

def _return_bool(value,default=True):
    if value is None:return bool(default)
    if isinstance(value,bool):return value
    return str(value).strip().lower() in ('1','true','yes','on')

def _return_store_media(user_id,kind,file_name,mime_type,data_url):
    if kind not in _RETURN_MEDIA_LIMITS:return None,'invalid_media_kind'
    ext=_RETURN_MEDIA_MIME.get(kind,{}).get(mime_type)
    if not ext:return None,'unsupported_media_type'
    if not isinstance(data_url,str) or ',' not in data_url:return None,'invalid_media_payload'
    header,b64=data_url.split(',',1)
    if ';base64' not in header.lower():return None,'invalid_media_payload'
    max_bytes=_RETURN_MEDIA_LIMITS[kind]
    if len(b64) > int(max_bytes*1.5)+16:return None,'media_too_large'
    try:raw=base64.b64decode(b64,validate=True)
    except Exception:return None,'invalid_media_payload'
    if not raw or len(raw)>max_bytes:return None,'media_too_large'
    valid=True
    if mime_type=='image/png':valid=raw.startswith(b'\x89PNG\r\n\x1a\n')
    elif mime_type=='image/jpeg':valid=raw.startswith(b'\xff\xd8')
    elif mime_type=='image/webp':valid=len(raw)>=12 and raw[:4]==b'RIFF' and raw[8:12]==b'WEBP'
    elif mime_type in ('video/webm','audio/webm'):valid=raw.startswith(b'\x1aE\xdf\xa3')
    elif mime_type in ('video/mp4','audio/mp4'):valid=len(raw)>=12 and raw[4:8]==b'ftyp'
    elif mime_type=='audio/ogg':valid=raw.startswith(b'OggS')
    elif mime_type=='audio/mpeg':valid=raw.startswith(b'ID3') or (len(raw)>1 and raw[0]==0xff and (raw[1]&0xe0)==0xe0)
    if not valid:return None,'media_signature_mismatch'
    mid='rm_'+secrets.token_hex(12)
    safe_name=clean(file_name,160) or f'{kind}.{ext}'
    return {'id':mid,'file_name':safe_name,'mime_type':mime_type,'data_b64':b64,'byte_size':len(raw)},None

_c009x_get_base=App.do_GET
def _c009x_do_GET(self):
    parsed=urlparse(self.path);path=parsed.path;q=parse_qs(parsed.query)
    if path=='/api/return/workspace':
        s=self.need()
        if not s:return
        con=db()
        try:out=build_return_workspace(con,s['id'])
        finally:con.close()
        return self.json(out)
    if path=='/api/return/media':
        s=self.need()
        if not s:return
        media_id=clean(qval(q,'id'),80)
        con=db();row=con.execute('SELECT file_name,mime_type,data_b64 FROM return_media WHERE id=? AND user_id=?',(media_id,s['id'])).fetchone();con.close()
        if not row:return self.json({'error':'media_not_found'},404)
        try:raw=base64.b64decode(row['data_b64'],validate=True)
        except Exception:return self.json({'error':'media_data_corrupt'},500)
        self.send_response(200);self.send_header('Content-Type',row['mime_type']);self.send_header('Cache-Control','private, no-store');self.send_header('Content-Disposition',f'inline; filename="{clean(row["file_name"],120).replace(chr(34),"")}"');self.send_common();self.send_header('Content-Length',str(len(raw)));self.end_headers();self.wfile.write(raw);return
    return _c009x_get_base(self)
App.do_GET=_c009x_do_GET

_c009x_post_base=App.do_POST
def _c009x_do_POST(self):
    path=urlparse(self.path).path
    if path=='/api/return/tip-rating':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        try:tip_id=int(b.get('tip_id') or 0);rating=int(b.get('rating') or 0)
        except Exception:return self.json({'error':'invalid_tip_rating'},400)
        if rating not in (1,2,3,4,5):return self.json({'error':'rating_must_be_1_to_5'},400)
        note=clean(b.get('note'),800);con=db();tip=con.execute('SELECT id FROM tips WHERE id=? AND user_id=?',(tip_id,s['id'])).fetchone()
        if not tip:con.close();return self.json({'error':'tip_not_found'},404)
        old=con.execute('SELECT tip_id FROM return_tip_feedback WHERE user_id=? AND tip_id=?',(s['id'],tip_id)).fetchone()
        if old:con.execute('UPDATE return_tip_feedback SET rating=?,note=?,updated_at=? WHERE user_id=? AND tip_id=?',(rating,note,now(),s['id'],tip_id))
        else:con.execute('INSERT INTO return_tip_feedback(user_id,tip_id,rating,note,updated_at) VALUES(?,?,?,?,?)',(s['id'],tip_id,rating,note,now()))
        _return_record(con,s['id'],'R006','tip_rated',{'tip_id':tip_id,'rating':rating});con.commit();con.close()
        return self.json({'ok':True,'tip_id':tip_id,'rating':rating})
    if path=='/api/return/goal':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        action=clean(b.get('action') or 'save',20);goal_id=clean(b.get('id'),80);con=db()
        if action=='delete':
            if not goal_id:con.close();return self.json({'error':'goal_id_required'},400)
            cur=con.execute('DELETE FROM return_goals WHERE id=? AND user_id=?',(goal_id,s['id']))
            _return_record(con,s['id'],'R023','goal_deleted',{'id':goal_id});con.commit();con.close();return self.json({'ok':True,'deleted':cur.rowcount if hasattr(cur,'rowcount') else 1})
        goal_type=clean(b.get('goal_type'),40)
        if goal_type not in SAFE_GOAL_TYPES:con.close();return self.json({'error':'unsafe_or_unknown_goal_type','allowed':sorted(SAFE_GOAL_TYPES)},400)
        try:target=max(1,min(365,int(b.get('target') or 1)))
        except Exception:con.close();return self.json({'error':'invalid_goal_target'},400)
        title=clean(b.get('title'),120) or SAFE_GOAL_TYPES[goal_type]['title']
        if not goal_id:goal_id='rg_'+secrets.token_hex(10)
        existing=con.execute('SELECT id FROM return_goals WHERE id=? AND user_id=?',(goal_id,s['id'])).fetchone()
        if existing:con.execute('UPDATE return_goals SET goal_type=?,target=?,title=?,status=?,updated_at=? WHERE id=? AND user_id=?',(goal_type,target,title,'active',now(),goal_id,s['id']))
        else:con.execute('INSERT INTO return_goals(id,user_id,goal_type,target,title,status,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?)',(goal_id,s['id'],goal_type,target,title,'active',now(),now()))
        _return_record(con,s['id'],'R023','goal_saved',{'id':goal_id,'goal_type':goal_type,'target':target});_return_record(con,s['id'],'R024','goal_progress_available',{'id':goal_id});con.commit();con.close()
        return self.json({'ok':True,'id':goal_id,'goal_type':goal_type,'target':target})
    if path=='/api/return/preferences':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        con=db();old=load_preferences(con,s['id'])
        values={
            'notifications_enabled':_return_bool(b.get('notifications_enabled'),old['notifications_enabled']),
            'tip_notifications':_return_bool(b.get('tip_notifications'),old['tip_notifications']),
            'review_notifications':_return_bool(b.get('review_notifications'),old['review_notifications']),
        }
        exists=con.execute('SELECT user_id FROM return_preferences WHERE user_id=?',(s['id'],)).fetchone()
        if exists:con.execute('UPDATE return_preferences SET notifications_enabled=?,tip_notifications=?,review_notifications=?,updated_at=? WHERE user_id=?',(1 if values['notifications_enabled'] else 0,1 if values['tip_notifications'] else 0,1 if values['review_notifications'] else 0,now(),s['id']))
        else:con.execute('INSERT INTO return_preferences(user_id,notifications_enabled,tip_notifications,review_notifications,pause_until,updated_at) VALUES(?,?,?,?,?,?)',(s['id'],1 if values['notifications_enabled'] else 0,1 if values['tip_notifications'] else 0,1 if values['review_notifications'] else 0,'',now()))
        _return_record(con,s['id'],'R041','notification_controls_updated',values);con.commit();con.close()
        return self.json({'ok':True,**values})
    if path=='/api/return/pause':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        try:minutes=int(b.get('minutes') or 0)
        except Exception:return self.json({'error':'invalid_pause_duration'},400)
        if minutes not in (0,15,30,60,120,240):return self.json({'error':'pause_duration_not_allowed'},400)
        until='' if minutes==0 else (datetime.now(timezone.utc)+timedelta(minutes=minutes)).replace(microsecond=0).isoformat()
        con=db();prefs=load_preferences(con,s['id']);exists=con.execute('SELECT user_id FROM return_preferences WHERE user_id=?',(s['id'],)).fetchone()
        vals=(1 if prefs['notifications_enabled'] else 0,1 if prefs['tip_notifications'] else 0,1 if prefs['review_notifications'] else 0)
        if exists:con.execute('UPDATE return_preferences SET pause_until=?,updated_at=? WHERE user_id=?',(until,now(),s['id']))
        else:con.execute('INSERT INTO return_preferences(user_id,notifications_enabled,tip_notifications,review_notifications,pause_until,updated_at) VALUES(?,?,?,?,?,?)',(s['id'],*vals,until,now()))
        _return_record(con,s['id'],'R018','responsible_play_pause_set',{'minutes':minutes,'until':until});con.commit();con.close()
        return self.json({'ok':True,'active':bool(until),'until':until})
    if path=='/api/return/note':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        body=clean(b.get('body'),4000);note_type=clean(b.get('note_type') or 'reflection',40)
        if note_type not in ('reflection','voice_transcript','session_review'):return self.json({'error':'invalid_note_type'},400)
        if not body:return self.json({'error':'note_body_required'},400)
        nid='rn_'+secrets.token_hex(10);tags=smart_tags(body,note_type,clean(b.get('platform'),80));con=db()
        con.execute('INSERT INTO return_notes(id,user_id,note_type,body,tags_json,created_at) VALUES(?,?,?,?,?,?)',(nid,s['id'],note_type,body,json.dumps(tags),now()))
        feature='R033' if note_type=='voice_transcript' else 'R034';_return_record(con,s['id'],feature,'note_saved',{'id':nid,'note_type':note_type,'tags':tags});con.commit();con.close()
        return self.json({'ok':True,'id':nid,'tags':tags})
    if path=='/api/return/saved-view':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        action=clean(b.get('action') or 'save',20);view_id=clean(b.get('id'),80);con=db()
        if action=='delete':
            con.execute('DELETE FROM return_saved_views WHERE id=? AND user_id=?',(view_id,s['id']));_return_record(con,s['id'],'R035','saved_view_deleted',{'id':view_id});con.commit();con.close();return self.json({'ok':True})
        title=clean(b.get('title'),120)
        if not title:con.close();return self.json({'error':'saved_view_title_required'},400)
        raw_config=b.get('config') if isinstance(b.get('config'),dict) else {}
        config={}
        for k,v in raw_config.items():
            key=clean(k,80)
            if key and (isinstance(v,(str,int,float,bool)) or v is None):config[key]=clean(v,300) if isinstance(v,str) else v
        if not view_id:view_id='rv_'+secrets.token_hex(10)
        existing=con.execute('SELECT id FROM return_saved_views WHERE id=? AND user_id=?',(view_id,s['id'])).fetchone()
        payload=json.dumps(config,separators=(',',':'))
        if existing:con.execute('UPDATE return_saved_views SET title=?,config_json=?,updated_at=? WHERE id=? AND user_id=?',(title,payload,now(),view_id,s['id']))
        else:con.execute('INSERT INTO return_saved_views(id,user_id,title,config_json,created_at,updated_at) VALUES(?,?,?,?,?,?)',(view_id,s['id'],title,payload,now(),now()))
        _return_record(con,s['id'],'R035','saved_view_saved',{'id':view_id,'keys':sorted(config)});con.commit();con.close()
        return self.json({'ok':True,'id':view_id,'title':title,'config':config})
    if path=='/api/return/media':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        kind=clean(b.get('kind'),20);mime=clean(b.get('mime_type'),80);info,error=_return_store_media(s['id'],kind,b.get('file_name'),mime,b.get('data_url'))
        if error:return self.json({'error':error},413 if error=='media_too_large' else 400)
        tags=smart_tags(info['file_name'],kind,clean(b.get('platform'),80));con=db()
        con.execute('INSERT INTO return_media(id,user_id,kind,file_name,mime_type,data_b64,byte_size,review_note,tags_json,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?)',(info['id'],s['id'],kind,info['file_name'],mime,info['data_b64'],info['byte_size'],'',json.dumps(tags),now(),now()))
        feature={'screenshot':'R031','video':'R032','voice':'R033'}[kind];_return_record(con,s['id'],feature,'media_uploaded',{'id':info['id'],'kind':kind,'byte_size':info['byte_size'],'tags':tags});con.commit();con.close()
        return self.json({'ok':True,'id':info['id'],'kind':kind,'byte_size':info['byte_size'],'tags':tags})
    if path=='/api/return/media-review':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        media_id=clean(b.get('id'),80);note=clean(b.get('review_note'),4000);con=db();row=con.execute('SELECT kind,file_name FROM return_media WHERE id=? AND user_id=?',(media_id,s['id'])).fetchone()
        if not row:con.close();return self.json({'error':'media_not_found'},404)
        tags=smart_tags(note,row['kind'],clean(b.get('platform'),80));con.execute('UPDATE return_media SET review_note=?,tags_json=?,updated_at=? WHERE id=? AND user_id=?',(note,json.dumps(tags),now(),media_id,s['id']))
        feature='R032' if row['kind']=='video' else ('R031' if row['kind']=='screenshot' else 'R033');_return_record(con,s['id'],feature,'media_reviewed',{'id':media_id,'kind':row['kind'],'tags':tags});con.commit();con.close()
        return self.json({'ok':True,'id':media_id,'tags':tags})
    return _c009x_post_base(self)
App.do_POST=_c009x_do_POST

# Respect the user's notification controls in the existing Today dashboard.
_c009x_dashboard_base=_return_dashboard
def _return_dashboard(con,user_id):
    out=_c009x_dashboard_base(con,user_id);prefs=load_preferences(con,user_id)
    if not prefs['notifications_enabled']:out['notifications']=[]
    else:
        allowed=[]
        for item in out.get('notifications',[]):
            if item.get('kind')=='tip' and not prefs['tip_notifications']:continue
            if item.get('kind')=='review' and not prefs['review_notifications']:continue
            allowed.append(item)
        out['notifications']=allowed
    out['notificationControls']=prefs
    return out
