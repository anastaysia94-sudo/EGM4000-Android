
# C007/C008 owner Monetization Control Center.
# This persists non-secret product/readiness configuration only. Provider credentials
# must remain in deployment secret storage and are deliberately rejected here.
_c=db()
try:
    _c.execute('''CREATE TABLE IF NOT EXISTS monetization_channel_settings(
      id TEXT PRIMARY KEY,
      config_json TEXT NOT NULL DEFAULT '{}',
      notes TEXT NOT NULL DEFAULT '',
      updated_by INTEGER,
      updated_at TEXT NOT NULL
    )''')
    _c.commit()
finally:_c.close()

_MONETIZATION_IDS={f'A{i:03d}' for i in range(71,96)}
_MONETIZATION_STATES={'configuration_required','configured','verified','disabled'}
_SECRET_KEY_RE=re.compile(r'(secret|token|password|private|api[_-]?key|credential)',re.I)

def _safe_monetization_config(raw):
    if not isinstance(raw,dict):return {}
    out={}
    for k,v in raw.items():
        key=clean(k,80)
        if not key or _SECRET_KEY_RE.search(key):
            raise ValueError('secret_fields_not_allowed')
        if isinstance(v,(str,int,float,bool)) or v is None:out[key]=v if not isinstance(v,str) else clean(v,500)
    return out

_c008_get_base=App.do_GET
def _c008_do_GET(self):
    parsed=urlparse(self.path);path=parsed.path
    if path=='/api/admin/monetization':
        s=self.need(owner=True)
        if not s:return
        con=db();rows=rowsdict(con.execute("SELECT m.id,a.title,a.category,m.enabled,m.provider_status,COALESCE(s.config_json,'{}') config_json,COALESCE(s.notes,'') notes,s.updated_at FROM monetization_channels m LEFT JOIN admin_features a ON a.id=m.id LEFT JOIN monetization_channel_settings s ON s.id=m.id WHERE m.id>='A071' AND m.id<='A095' ORDER BY m.id").fetchall());con.close()
        summary={'total':len(rows),'enabled':0,'configuration_required':0,'configured':0,'verified':0,'disabled':0}
        for r in rows:
            try:r['config']=json.loads(r.pop('config_json') or '{}')
            except Exception:r['config']={}
            r['enabled']=bool(r.get('enabled'));summary['enabled']+=1 if r['enabled'] else 0
            state=r.get('provider_status') or 'configuration_required';summary[state]=summary.get(state,0)+1
        return self.json({'schema':'egm.admin.monetization.v1','summary':summary,'channels':rows,'secret_policy':'Provider credentials are never accepted by this endpoint. Configure secrets in deployment environment/secret storage.'})
    return _c008_get_base(self)
App.do_GET=_c008_do_GET

_c008_post_base=App.do_POST
def _c008_do_POST(self):
    path=urlparse(self.path).path
    if path=='/api/admin/monetization':
        b=self.body();s=self.need(owner=True,csrf=True)
        if not s:return
        cid=clean(b.get('id'),8);state=clean(b.get('provider_status') or 'configuration_required',40);notes=clean(b.get('notes'),3000)
        if cid not in _MONETIZATION_IDS:return self.json({'error':'invalid_monetization_capability'},400)
        if state not in _MONETIZATION_STATES:return self.json({'error':'invalid_provider_status'},400)
        try:config=_safe_monetization_config(b.get('config') or {})
        except ValueError:return self.json({'error':'secret_fields_not_allowed','detail':'Store provider credentials in deployment secret storage, not monetization configuration.'},400)
        enabled=1 if b.get('enabled') else 0
        if enabled and state not in ('configured','verified'):return self.json({'error':'provider_not_ready','detail':'A channel can only be enabled after provider status is configured or verified.'},409)
        con=db();exists=con.execute('SELECT id FROM monetization_channels WHERE id=?',(cid,)).fetchone()
        if not exists:con.close();return self.json({'error':'monetization_capability_not_found'},404)
        con.execute('UPDATE monetization_channels SET enabled=?,provider_status=? WHERE id=?',(enabled,state,cid))
        old=con.execute('SELECT id FROM monetization_channel_settings WHERE id=?',(cid,)).fetchone()
        payload=json.dumps(config,separators=(',',':'))
        if old:con.execute('UPDATE monetization_channel_settings SET config_json=?,notes=?,updated_by=?,updated_at=? WHERE id=?',(payload,notes,s['id'],now(),cid))
        else:con.execute('INSERT INTO monetization_channel_settings(id,config_json,notes,updated_by,updated_at) VALUES(?,?,?,?,?)',(cid,payload,notes,s['id'],now()))
        audit(con,s['id'],'monetization_configuration_updated','admin_feature',cid,{'enabled':bool(enabled),'provider_status':state,'config_keys':sorted(config.keys())});con.commit();con.close()
        return self.json({'ok':True,'id':cid,'enabled':bool(enabled),'provider_status':state,'config':config})
    return _c008_post_base(self)
App.do_POST=_c008_do_POST
