
# C008 A077: real priority-processing queue behavior for open custom-report requests.
from priority_processing import admin_priority_queue,apply_priority,grant_entitlement as grant_priority_entitlement,migrate_priority_processing,my_priority_status,remove_priority,revoke_entitlement as revoke_priority_entitlement

_c008p=db()
try:migrate_priority_processing(_c008p)
finally:_c008p.close()

_C008_PRIORITY_ACTION_FIELDS={'action','request_id'}
_C008_PRIORITY_ENTITLEMENT_FIELDS={'action','user_id','source','note'}

def _c008_priority_error(self,exc):
    code=str(exc)
    if code in ('priority_report_request_not_found','priority_entitlement_user_not_found','priority_entitlement_not_found','priority_entry_not_found'):
        status=404
    elif code=='priority_entitlement_required':
        status=403
    elif code=='priority_requires_open_report_request':
        status=409
    else:
        status=400
    return self.json({'error':code},status)

_c008p_get_base=App.do_GET
def _c008p_do_GET(self):
    path=urlparse(self.path).path
    if path=='/api/priority-processing/status':
        s=self.need()
        if not s:return
        con=db()
        try:payload=my_priority_status(con,s['id'])
        finally:con.close()
        return self.json(payload)
    if path=='/api/admin/priority-processing':
        s=self.need(owner=True)
        if not s:return
        con=db()
        try:payload=admin_priority_queue(con)
        finally:con.close()
        return self.json(payload)
    return _c008p_get_base(self)
App.do_GET=_c008p_do_GET

_c008p_post_base=App.do_POST
def _c008p_do_POST(self):
    path=urlparse(self.path).path
    if path=='/api/priority-processing/apply':
        b=self.body();s=self.need(csrf=True)
        if not s:return
        unknown=set(b)-_C008_PRIORITY_ACTION_FIELDS
        if unknown:return self.json({'error':'unsupported_priority_action_fields','fields':sorted(str(x) for x in unknown)},400)
        action=clean(b.get('action') or 'apply',30)
        request_id=clean(b.get('request_id'),100)
        con=db()
        try:
            if action=='apply':
                entry=apply_priority(con,s['id'],request_id)
                audit(con,s['id'],'priority_processing_applied','custom_report_request',request_id,{'feature_id':'A077','payment_verified':False});con.commit()
            elif action=='remove':
                entry=remove_priority(con,s['id'],request_id)
                audit(con,s['id'],'priority_processing_removed','custom_report_request',request_id,{'feature_id':'A077'});con.commit()
            else:
                con.close();return self.json({'error':'unsupported_priority_action'},400)
        except ValueError as exc:
            con.rollback();con.close();return _c008_priority_error(self,exc)
        con.close();return self.json({'ok':True,'entry':entry})
    if path=='/api/admin/priority-processing-entitlement':
        b=self.body();s=self.need(owner=True,csrf=True)
        if not s:return
        unknown=set(b)-_C008_PRIORITY_ENTITLEMENT_FIELDS
        if unknown:return self.json({'error':'unsupported_priority_entitlement_fields','fields':sorted(str(x) for x in unknown)},400)
        action=clean(b.get('action') or 'grant',30)
        try:user_id=int(b.get('user_id'))
        except Exception:return self.json({'error':'valid_user_id_required'},400)
        con=db()
        try:
            if action=='grant':
                entitlement=grant_priority_entitlement(con,user_id,b.get('source'),b.get('note'),s['id'])
                audit(con,s['id'],'priority_processing_entitlement_granted','user',str(user_id),{'feature_id':'A077','source':entitlement['source'],'payment_verified':False});con.commit()
            elif action=='revoke':
                entitlement=revoke_priority_entitlement(con,user_id,b.get('note'),s['id'])
                audit(con,s['id'],'priority_processing_entitlement_revoked','user',str(user_id),{'feature_id':'A077'});con.commit()
            else:
                con.close();return self.json({'error':'unsupported_priority_entitlement_action'},400)
        except ValueError as exc:
            con.rollback();con.close();return _c008_priority_error(self,exc)
        con.close();return self.json({'ok':True,'entitlement':entitlement})
    return _c008p_post_base(self)
App.do_POST=_c008p_do_POST
