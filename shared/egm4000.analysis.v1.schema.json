{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartpickshop.local/schemas/egm4000.analysis.v1.schema.json",
  "title": "EGM4000 Session Analysis v1",
  "type": "object",
  "required": ["schema", "sessionId", "platform", "generatedAt", "evidence", "metrics", "patterns"],
  "properties": {
    "schema": {"const": "egm.analysis.v1"},
    "sessionId": {"type": "string"},
    "platform": {"type": "string"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "object",
      "required": ["eventCount", "meanReliability", "completeness", "confidence"],
      "properties": {
        "eventCount": {"type": "integer", "minimum": 0},
        "evidenceTypes": {"type": "array", "items": {"type": "string"}},
        "meanReliability": {"type": "number", "minimum": 0, "maximum": 1},
        "completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "metrics": {"type": "object"},
    "segments": {"type": "object"},
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "severity", "evidence", "confidence", "why"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "severity": {"type": "string"},
          "evidence": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "why": {"type": "string"}
        }
      }
    },
    "normalizedEvents": {"type": "array"}
  },
  "additionalProperties": true
}
